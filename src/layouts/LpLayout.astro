---
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import WaIcon from '../components/WaIcon.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  schema: unknown;
  footerDisclaimer: string;
  footerServiceHref: string;
  footerServiceLabel: string;
  whatsappUrl: string;
  stickyLabel?: string;
}

const { title, description, canonical, schema, footerDisclaimer, footerServiceHref, footerServiceLabel, whatsappUrl, stickyLabel = 'Evaluar mi caso gratis' } = Astro.props;
---

<BaseLayout title={title} description={description} canonical={canonical} hidePopup={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main id="main-content">
    <header class="lp-header">
      <div class="shell lp-header-inner">
        <a href="/" class="lp-logo" aria-label="Legatum Internacional — inicio">
          <img src="/favicon.svg" width="26" height="26" alt="" aria-hidden="true" />
          <span class="wordmark">
            <strong>LEGATUM</strong>
            <small>INTERNACIONAL</small>
          </span>
        </a>
        <p class="lp-disclaimer-tag">Servicio privado de consultoría · No somos entidad gubernamental</p>
      </div>
    </header>

    <slot />

    <footer class="lp-footer">
      <div class="shell lp-footer-inner">
        <p><strong>Aviso legal:</strong> {footerDisclaimer}</p>
        <nav class="lp-footer-nav">
          <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
          <a href="/terminos/">Términos de servicio</a>
          <a href={footerServiceHref}>{footerServiceLabel}</a>
        </nav>
      </div>
    </footer>
  </main>
  <WhatsAppFloat />

  <!-- Barra sticky de WhatsApp — solo móvil, siempre a un clic para tráfico de Ads -->
  <a class="lp-sticky-wa" href={whatsappUrl} target="_blank" rel="noopener noreferrer" data-wa-location="sticky-movil">
    <WaIcon /><span>{stickyLabel}</span>
  </a>
</BaseLayout>

<style is:global>
  .lp-header { background: var(--navy); padding: 18px 0; border-bottom: 1px solid var(--line-light); }
  .lp-header-inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }
  .lp-logo { display: flex; align-items: center; gap: 12px; color: var(--cream); text-decoration: none; }
  .lp-logo img { filter: brightness(10); opacity: .88; }
  .lp-logo .wordmark strong { font-size: 1.18rem; letter-spacing: .13em; }
  .lp-logo .wordmark small { font-size: .5rem; letter-spacing: .38em; color: var(--gold-300); }
  .lp-disclaimer-tag { font-size: .68rem; color: rgba(196,168,130,.65); letter-spacing: .05em; border: 1px solid rgba(196,168,130,.2); padding: 5px 11px; line-height: 1; }

  .lp-hero { padding-block: clamp(40px, 6vw, 72px); }
  .lp-ey        { animation: hero-enter .65s var(--ease) .1s both; }
  .lp-h1        { animation: hero-enter .75s var(--ease) .26s both; }
  .lp-lead-anim { animation: hero-enter .65s var(--ease) .46s both; }
  .lp-hero .eyebrow { color: var(--gold-300); }
  .lp-hero h1 { color: var(--white); font-size: clamp(2.8rem, 5.5vw, 4.6rem); margin-top: .7em; }
  .lp-hero-lead { color: rgba(245,240,232,.78); font-size: clamp(1.05rem, 1.7vw, 1.28rem); line-height: 1.65; max-width: 58ch; margin-top: 1.3rem; }
  .lp-hero .hero-actions { margin-top: 2rem; }
  .lp-hero .hero-reassurance { margin-top: .9rem; }
  .lp-hero .hero-metrics { margin-top: 3rem; }
  .lp-hero .hero-metrics dt { font-size: 2rem; }

  .lp-mid-cta { padding-block: clamp(28px, 4vw, 44px); border-block: 1px solid var(--line-light); }
  .lp-mid-cta-inner { display: flex; align-items: center; gap: clamp(20px, 5vw, 52px); flex-wrap: wrap; }
  .lp-mid-cta-inner > p { color: var(--cream); font-family: var(--serif); font-size: clamp(1.1rem, 2vw, 1.55rem); flex: 1; min-width: 200px; margin: 0; }
  .lp-mid-note { color: rgba(245,240,232,.4); font-size: .78rem; white-space: nowrap; }

  .lp-svc-grid { display: grid; grid-template-columns: 1fr 330px; gap: clamp(40px, 6vw, 90px); align-items: start; }
  .lp-svc-grid .section-header { margin-bottom: clamp(28px, 4vw, 40px); }
  .lp-svc-grid .section-header p { color: var(--ink); }
  .lp-includes-list { gap: 22px; }
  .lp-includes-list li { padding-block: 8px 6px; }
  .lp-includes-list strong { font-size: .97rem; line-height: 1.45; }
  .lp-guarantee { margin-top: 2.6rem; font-size: .97rem; line-height: 1.7; }

  .lp-fee-card { padding: 36px 32px; background: var(--white); border-top: 2px solid var(--gold); box-shadow: 0 28px 70px rgba(12,24,46,.09); position: sticky; top: 24px; display: flex; flex-direction: column; }
  .lp-fee-label { font-size: .65rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; color: var(--gold); }
  .lp-fee-amount { font-family: var(--serif); font-size: 2.5rem; font-weight: 600; color: var(--navy); line-height: 1; margin-top: .7rem; }
  .lp-fee-usd { color: var(--gold); font-size: .88rem; margin-top: .6rem; }
  .lp-fee-divider { border: none; border-top: 1px solid var(--line); margin: 1.6rem 0; }
  .lp-fee-frame { color: var(--muted); font-size: .86rem; line-height: 1.75; }
  .lp-fee-frame strong { color: var(--navy); }
  .lp-fee-cta { width: 100%; justify-content: center; margin-top: 1.6rem; }
  .lp-fee-micro { margin-top: .8rem; text-align: center; color: var(--muted); font-size: .72rem; line-height: 1.5; }

  .lp-final { padding-block: clamp(64px, 9vw, 100px); }
  .lp-final-wa-only { max-width: 600px; }
  .lp-final-wa-only h2 { color: var(--white); }
  .lp-final .eyebrow { color: var(--gold-300); }
  .lp-final-head { max-width: 640px; margin-bottom: clamp(36px, 5vw, 52px); }
  .lp-final-head h2 { color: var(--white); margin-top: .35em; }
  .lp-final-lead { color: rgba(245,240,232,.72); line-height: 1.7; max-width: 56ch; margin-top: .85rem; font-size: 1rem; }
  .lp-final-left { max-width: 520px; }
  .lp-final-channel-label { color: var(--gold-300); font-size: .68rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; margin-bottom: .9rem; }
  .lp-final-wa { font-size: 1.05rem; padding: 16px 24px; width: 100%; justify-content: center; }
  .lp-final-wa-note { color: rgba(245,240,232,.42); font-size: .78rem; margin-top: .75rem; line-height: 1.4; }
  .lp-trust-list { margin-top: 2rem; display: grid; gap: 14px; border-top: 1px solid var(--line-light); padding-top: 1.6rem; }
  .lp-trust-list li { color: rgba(245,240,232,.65); font-size: .88rem; line-height: 1.4; display: flex; gap: .7rem; }
  .lp-trust-list span { color: var(--gold-300); flex-shrink: 0; }
  .lp-final-form { max-width: 720px; margin-top: clamp(36px, 5vw, 56px); border-top: 1px solid var(--line-light); padding-top: clamp(36px, 5vw, 52px); }
  .lp-form-label { color: var(--cream); font-family: var(--serif); font-size: 1.05rem; margin-bottom: 1.2rem; opacity: .82; }
  .lp-final-form .form-grid { grid-template-columns: repeat(2, 1fr); }
  .lp-final-form .form-grid .full { grid-column: 1 / -1; }

  .lp-footer { background: var(--cream); border-top: 1px solid var(--line); padding-block: 28px; }
  .lp-footer-inner { display: grid; gap: 14px; }
  .lp-footer p { color: var(--muted); font-size: .77rem; line-height: 1.7; max-width: 860px; }
  .lp-footer p strong { color: var(--ink); }
  .lp-footer-nav { display: flex; flex-wrap: wrap; gap: .4rem 1.4rem; }
  .lp-footer-nav a { color: var(--gold); font-size: .77rem; }

  /* ── Barra sticky de WhatsApp (móvil) ── */
  .lp-sticky-wa { display: none; }

  /* ── Badge de precio compacto (cerca del hero) ── */
  .lp-price-badge { display: inline-flex; align-items: baseline; gap: .6rem; flex-wrap: wrap; margin-top: 1.8rem; padding: 12px 20px; background: rgba(196,168,130,.1); border: 1px solid rgba(196,168,130,.32); border-radius: 4px; }
  .lp-price-badge .lab { color: var(--gold-300); font-size: .68rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; }
  .lp-price-badge .amt { color: var(--white); font-family: var(--serif); font-size: 1.45rem; font-weight: 600; }
  .lp-price-badge .usd { color: rgba(245,240,232,.6); font-size: .8rem; }

  /* ── Imágenes de sección ── */
  .lp-img-section { display: grid; gap: clamp(32px, 5vw, 56px); }
  .lp-section-img { width: 100%; height: 340px; object-fit: cover; border-radius: 8px; box-shadow: 0 20px 50px rgba(12,24,46,.13); margin-top: clamp(28px, 4vw, 44px); }
  .lp-service-img { width: 100%; height: 300px; object-fit: cover; border-radius: 8px; box-shadow: 0 20px 50px rgba(12,24,46,.12); margin-top: 2rem; }

  /* ── Hero: dos columnas — texto izquierda, video derecha ── */
  .lp-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }

  /* ── Hero: dos columnas — texto izquierda, video derecha ── */
  .lp-hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 64px); align-items: center; }

  /* ── Video testimonio en el hero (autoplay silenciado) ── */
  .lp-hero-video { width: 100%; border-radius: 12px; overflow: hidden; background: #0c182e; box-shadow: 0 34px 80px rgba(8,16,30,.5); border: 1px solid var(--line-light); }
  .lp-hero-video video { display: block; width: 100%; height: auto; }
  .lp-hero-video-cap { text-align: center; color: rgba(245,240,232,.6); font-size: .76rem; letter-spacing: .03em; padding: 9px 8px; margin: 0; }

  /* ── Video testimonio (sección) ── */
  .lp-video-sec { text-align: center; }
  .lp-video-wrap { max-width: 420px; margin: clamp(28px,4vw,40px) auto 0; border-radius: 10px; overflow: hidden; background: #0c182e; box-shadow: 0 30px 70px rgba(12,24,46,.4); border: 1px solid var(--line-light); }
  .lp-video-wrap video { display: block; width: 100%; height: auto; }
  .lp-video-cap { margin-top: 1.4rem; color: rgba(245,240,232,.62); font-size: .85rem; }

  @media (max-width: 1000px) {
    .lp-svc-grid { grid-template-columns: 1fr; }
    .lp-fee-card { position: static; }
  }
  @media (max-width: 860px) {
    .lp-hero-grid { grid-template-columns: 1fr; }
    .lp-hero-video { max-width: 500px; margin: 2rem auto 0; }
  }
  @media (max-width: 760px) {
    .lp-hero .hero-metrics { gap: 20px 28px; }
    .lp-mid-cta-inner { flex-direction: column; align-items: flex-start; gap: 14px; }
    .lp-final-form { max-width: 100%; }
    .lp-final-form .form-grid { grid-template-columns: 1fr; }

    /* Botón WhatsApp pegajoso abajo para tráfico de Google Ads */
    .lp-sticky-wa {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 95;
      align-items: center; justify-content: center; gap: 10px;
      padding: 15px 18px; background: #1f7a4d; color: var(--white);
      font-size: 1rem; font-weight: 700; letter-spacing: .01em;
      box-shadow: 0 -10px 30px rgba(8,16,30,.28); text-decoration: none;
    }
    .lp-sticky-wa svg { width: 22px; height: 22px; flex: 0 0 auto; }
    .lp-sticky-wa::after { content: " →"; }
    .whatsapp-float { display: none; }      /* evita doble botón en móvil */
    #main-content { padding-bottom: 66px; }  /* espacio para la barra sticky */
  }
  @media (max-width: 560px) {
    .lp-header-inner { flex-direction: column; align-items: flex-start; }
  }
</style>
