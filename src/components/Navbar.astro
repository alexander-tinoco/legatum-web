---
import { Image } from 'astro:assets';
import monogramCream from '../assets/brand/li-monogram-cream.png';
import monogramNavy from '../assets/brand/li-monogram-navy.png';
import { navItems, site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import WaIcon from './WaIcon.astro';

const isHome = Astro.url.pathname === '/';
const a = (href: string) => href.startsWith('/') ? href : isHome ? href : `/${href}`;
---

<header class="site-header" data-header>
  <div class="shell header-shell">
    <a class="brand" href={isHome ? '#top' : '/'} aria-label="Legatum Internacional, inicio">
      <span class="brand-mark" aria-hidden="true">
        <Image src={monogramCream} alt="" width={34} height={42} densities={[1, 2]} class="mark-light" loading="eager" />
        <Image src={monogramNavy} alt="" width={34} height={42} densities={[1, 2]} class="mark-dark" loading="eager" />
      </span>
      <span class="wordmark"><strong>LEGATUM</strong><small>INTERNACIONAL</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      {navItems.map((item) => <a href={a(item.href)}>{item.label}</a>)}
      <a href="/blog/">Guías</a>
    </nav>

    <div class="header-actions">
      <a class="btn btn-small btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="navbar">
        <WaIcon />Evaluar mi caso
      </a>
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu-head">
    <span class="wordmark"><strong>LEGATUM</strong><small>INTERNACIONAL</small></span>
    <button type="button" aria-label="Cerrar menú" data-menu-close>×</button>
  </div>
  <nav aria-label="Principal móvil">
    {navItems.map((item) => <a href={a(item.href)}>{item.label}</a>)}
    <a href="/blog/">Guías</a>
  </nav>
  <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="menu_movil">Iniciar evaluación</a>
  <SocialLinks class="mobile-social" />
</div>
