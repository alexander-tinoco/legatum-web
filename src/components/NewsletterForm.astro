---
---

<section class="newsletter-section">
  <div class="newsletter-inner">
    <p class="newsletter-label">Boletín gratuito</p>
    <h2 class="newsletter-title">Guías de visa y movilidad<br>directo a tu correo</h2>
    <p class="newsletter-subtitle">Sin spam. Solo lo que necesitas saber para viajar o emigrar con seguridad.</p>

    <form id="newsletter-form" class="newsletter-form" novalidate>
      <div class="newsletter-fields">
        <input
          type="email"
          id="nl-email"
          name="email"
          placeholder="tu@correo.com"
          required
          autocomplete="email"
        />
        <button type="submit" class="nl-btn">
          <span class="nl-btn-text">Suscribirme</span>
          <span class="nl-btn-loading" aria-hidden="true" hidden>Enviando…</span>
        </button>
      </div>
      <p class="nl-message" aria-live="polite" hidden></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement;
  const btnText = form.querySelector('.nl-btn-text') as HTMLElement;
  const btnLoading = form.querySelector('.nl-btn-loading') as HTMLElement;
  const message = form.querySelector('.nl-message') as HTMLElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = (form.querySelector('#nl-email') as HTMLInputElement).value.trim();

    btnText.hidden = true;
    btnLoading.hidden = false;
    message.hidden = true;

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const data = await res.json();

      if (data.ok) {
        message.textContent = '¡Listo! Revisa tu correo para confirmar.';
        message.className = 'nl-message nl-success';
        form.reset();
      } else {
        throw new Error();
      }
    } catch {
      message.textContent = 'Algo salió mal. Intenta de nuevo.';
      message.className = 'nl-message nl-error';
    } finally {
      btnText.hidden = false;
      btnLoading.hidden = true;
      message.hidden = false;
    }
  });
</script>

<style>
  .newsletter-section {
    background: var(--color-navy, #0c182e);
    padding: 5rem 1.5rem;
  }

  .newsletter-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-label {
    font-family: var(--font-sans, sans-serif);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold, #c9a96e);
    margin: 0 0 1rem;
  }

  .newsletter-title {
    font-family: var(--font-serif, serif);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 400;
    color: #fff;
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .newsletter-subtitle {
    font-family: var(--font-sans, sans-serif);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 2rem;
  }

  .newsletter-fields {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .newsletter-fields input[type="email"] {
    flex: 1 1 220px;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
    font-family: var(--font-sans, sans-serif);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s;
  }

  .newsletter-fields input[type="email"]::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .newsletter-fields input[type="email"]:focus {
    border-color: var(--color-gold, #c9a96e);
  }

  .nl-btn {
    padding: 0.75rem 1.75rem;
    background: var(--color-gold, #c9a96e);
    color: var(--color-navy, #0c182e);
    border: none;
    border-radius: 4px;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s;
  }

  .nl-btn:hover {
    opacity: 0.85;
  }

  .nl-message {
    margin-top: 1rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.9rem;
  }

  .nl-success { color: #6ee7b7; }
  .nl-error   { color: #fca5a5; }
</style>
