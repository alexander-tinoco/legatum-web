---
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const canonical = `${site.url}/herramientas/`;

const tools = [
  {
    label: 'Simulador de Visa Americana',
    desc: 'Diez preguntas sobre tu situación y obtienes un diagnóstico concreto: qué tan sólido es tu perfil, qué lo debilita y qué conviene resolver antes de solicitar.',
    href: '/herramientas/simulador-visa/',
    tag: 'Disponible',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
  },
  {
    label: 'Calculadora de Costos del Trámite',
    desc: 'Visa americana o canadiense. Elige tu ciudad y tipo de trámite para ver en qué vas a gastar: tarifa de gobierno, honorarios, traslado al consulado o VAC, y pasaporte.',
    href: '/herramientas/calculadora-costos/',
    tag: 'Disponible',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="1"/><path d="M8 6h8M8 10h8M8 14h5"/><circle cx="17" cy="17" r="3"/><path d="m19 19-1.5-1.5"/></svg>`,
  },
  {
    label: '¿Qué visa necesito?',
    desc: 'Tres preguntas para saber qué proceso te corresponde: visa americana, ETA canadiense, visa de visitante u otro. Sin rodeos.',
    href: '/herramientas/que-visa-necesito/',
    tag: 'Disponible',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>`,
  },
  {
    label: 'Checklist de arraigo',
    desc: 'Revisa tu expediente de arraigo antes de la entrevista consular: laboral, familiar, patrimonial y propósito de viaje. Cuatro áreas, un solo diagnóstico.',
    href: '/herramientas/checklist-arraigo/',
    tag: 'Disponible',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>`,
  },
];
---

<BaseLayout
  title={`Herramientas gratuitas | Visa americana y canadiense | ${site.name}`}
  description="Simulador de probabilidades, calculadora de costos, checklist de arraigo y más recursos gratuitos para preparar tu trámite de visa americana o canadiense."
  canonical={canonical}
>
  <Navbar />
  <main id="main-content">

    <section class="ht-hero section-navy">
      <div class="shell">
        <Breadcrumb crumbs={[{ label: 'Herramientas' }]} variant="dark" />
        <span class="eyebrow ht-ey">Herramientas gratuitas</span>
        <h1 class="ht-title ht-h1">Entiende tu caso antes de empezar.</h1>
        <p class="ht-lead">
          Cada herramienta está construida con los mismos criterios que usamos
          al preparar los expedientes. Úsalas para llegar a tu primera consulta con claridad.
        </p>
      </div>
    </section>

    <section class="section section-paper">
      <div class="shell">
        <a class="page-back" href="/">← Inicio</a>
        <div class="ht-grid">
          {tools.map((tool, i) => (
            <a class={`ht-card reveal${i > 0 ? ` d${Math.min(i, 3)}` : ''}`} href={tool.href}>
              <div class="ht-card-top">
                <div class="ht-icon" set:html={tool.icon} />
                <span class="ht-tag">{tool.tag}</span>
              </div>
              <h2 class="ht-card-title">{tool.label}</h2>
              <p class="ht-card-desc">{tool.desc}</p>
              <span class="ht-card-cta">Abrir herramienta →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .ht-ey   { animation: hero-enter .65s var(--ease) .1s both; }
  .ht-h1   { animation: hero-enter .75s var(--ease) .26s both; }
  .ht-lead { animation: hero-enter .65s var(--ease) .44s both; }
  .ht-hero {
    padding: clamp(72px, 10vw, 130px) 0 clamp(56px, 8vw, 100px);
    padding-top: calc(var(--header) + clamp(48px, 7vw, 80px));
  }
  .ht-title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    color: var(--white);
    margin: .5rem 0 1rem;
    max-width: none;
  }
  .ht-lead {
    max-width: 56ch;
    color: rgba(245,240,232,.75);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.65;
    margin: 0;
  }

  .ht-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: clamp(16px, 2.5vw, 28px);
    max-width: 860px;
  }

  .ht-card {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3.5vw, 36px);
    border: 1px solid var(--line);
    background: var(--white);
    text-decoration: none;
    color: inherit;
    transition: border-color .2s, box-shadow .2s, transform .25s var(--ease);
  }
  .ht-card:hover {
    border-color: var(--gold);
    box-shadow: 0 6px 28px rgba(12,24,46,.08);
    transform: translateY(-3px);
  }

  .ht-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 1.2rem;
  }
  .ht-icon {
    width: 36px;
    height: 36px;
    color: var(--gold);
    flex-shrink: 0;
  }
  .ht-icon svg { width: 100%; height: 100%; }

  .ht-tag {
    font-size: .62rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #2e7d32;
    background: rgba(46,125,50,.08);
    border: 1px solid rgba(46,125,50,.25);
    padding: 3px 9px;
    white-space: nowrap;
  }

  .ht-card-title {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    font-weight: 600;
    color: var(--navy);
    margin: 0 0 .7rem;
    line-height: 1.2;
  }
  .ht-card-desc {
    color: var(--muted);
    font-size: clamp(.88rem, 1.3vw, .95rem);
    line-height: 1.6;
    margin: 0 0 1.6rem;
    flex: 1;
  }
  .ht-card-cta {
    font-size: .82rem;
    font-weight: 650;
    letter-spacing: .04em;
    color: var(--gold);
    margin-top: auto;
  }
</style>
