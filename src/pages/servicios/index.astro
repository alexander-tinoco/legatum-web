---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { additionalDestinations, services, site } from '../../data/site';

const canonical = `${site.url}/servicios/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${canonical}#collection`,
      url: canonical,
      name: `Servicios de movilidad internacional | ${site.name}`,
      isPartOf: { '@id': `${site.url}/#website` },
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#list`,
      itemListElement: services.map((service, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: service.title,
        url: `${site.url}/servicios/${service.slug}/`,
      })),
    },
  ],
};
---

<BaseLayout
  title="Servicios de visas, pasaportes y movilidad internacional | Legatum Internacional"
  description="Servicios de movilidad internacional desde México: visa americana, renovación, visa canadiense, ETA Canadá, pasaporte mexicano y estadounidense. Expedientes preparados con rigor."
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Navbar />
  <main id="main-content">
    <section class="srvi-hero section-navy">
      <div class="shell">
        <Breadcrumb crumbs={[{ label: 'Servicios' }]} variant="dark" />
        <span class="eyebrow srvi-ey">Áreas de especialidad</span>
        <h1 class="srvi-h1">Cada proceso, una especialidad.</h1>
        <p class="srvi-lead">
          No administramos papeles. Analizamos su caso, definimos la ruta y respondemos por cada decisión hasta el final.
          Elija el servicio que necesita y conozca exactamente qué incluye, qué requiere y cuánto cuesta.
        </p>
        <div class="srvi-actions srvi-act">
          <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="servicios_hero">
            Iniciar mi evaluación
          </a>
          <a class="btn btn-ghost-light" href="/contacto/">Dejar mis datos</a>
        </div>
      </div>
    </section>

    <section class="section section-paper">
      <div class="shell">
        <a class="page-back" href="/">← Inicio</a>
        <div class="srvi-grid">
          {services.map((service, index) => (
            <a class={`srvi-card reveal${index > 0 ? ` d${Math.min(index % 3, 3)}` : ''}`} href={`/servicios/${service.slug}/`}>
              <span class="srvi-num">{String(index + 1).padStart(2, '0')}</span>
              <h2><abbr class="srvi-code">{service.flag}</abbr>{service.title}</h2>
              <p>{service.summary}</p>
              <ul class="srvi-tags">{service.tags.map((tag) => <li>{tag}</li>)}</ul>
            </a>
          ))}
        </div>

      </div>
    </section>

    <section class="section srvi-extra-section">
      <div class="shell srvi-extra reveal">
        <span class="eyebrow">Destinos adicionales</span>
        <h2 class="srvi-extra-h2">¿Su destino no está en la lista?</h2>
        <p>
          También preparamos expedientes para {additionalDestinations.join(', ')} y otros destinos.
          Cuéntenos su caso y evaluamos los requisitos reales con franqueza, sin compromiso.
        </p>
        <div class="srvi-extra-tags">
          <span>Visa Australia</span>
          <span>Visa China</span>

          <span>Otros destinos</span>
        </div>
        <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="servicios_otros">
          Consultar otro destino
        </a>
      </div>
    </section>

  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .srvi-hero {
    padding-top: calc(var(--header) + clamp(40px, 6vw, 72px));
    padding-bottom: clamp(48px, 7vw, 84px);
    border-bottom: 1px solid var(--line-light);
  }
  .srvi-ey  { animation: hero-enter .65s var(--ease) .1s both; }
  .srvi-h1  { animation: hero-enter .75s var(--ease) .26s both; }
  .srvi-lead { animation: hero-enter .65s var(--ease) .44s both; }
  .srvi-act { animation: hero-enter .6s var(--ease) .62s both; }
  .srvi-hero .bc { margin-bottom: 1.4rem; }
  .srvi-hero .eyebrow { color: var(--gold-300); }
  .srvi-hero h1 { color: var(--white); font-size: clamp(2.3rem, 5vw, 4rem); margin-top: .35em; max-width: 16ch; }
  .srvi-lead { max-width: 60ch; margin-top: 1.1rem; color: rgba(245, 240, 232, .82); font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; }
  .srvi-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2rem; }

  .srvi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
  .srvi-card { display: flex; flex-direction: column; gap: 12px; padding: 30px; background: var(--white); border: 1px solid var(--line); border-top: 2px solid transparent; transition: border-color .2s, transform .2s; }
  .srvi-card:hover { border-top-color: var(--gold); transform: translateY(-4px); }
  .srvi-num { font-family: var(--serif); font-size: 1rem; color: var(--gold); letter-spacing: .1em; }
  .srvi-card h2 { display: flex; align-items: center; gap: .6rem; font-size: clamp(1.3rem, 2vw, 1.6rem); color: var(--navy); }
  .srvi-flag { font-size: 1.4rem; }
  .srvi-code { font-family: var(--sans); font-size: .6rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--gold); margin-right: .4rem; text-decoration: none; font-style: normal; }
  .srvi-card p { color: var(--muted); font-size: .95rem; line-height: 1.55; flex: 1; }
  .srvi-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .srvi-tags li { padding: 3px 9px; border: 1px solid var(--line); color: var(--gold); font-size: .67rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .srvi-link { color: var(--gold); font-size: .82rem; font-weight: 650; letter-spacing: .04em; margin-top: .4rem; }

  .srvi-extra-section { background: var(--cream); }
  .srvi-extra { text-align: center; max-width: 680px; margin-inline: auto; }
  .srvi-extra-section .eyebrow { color: #7c6549; justify-content: center; }
  .srvi-extra-h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); margin-top: .35em; }
  .srvi-extra p { color: var(--muted); line-height: 1.7; margin: 1rem auto 1.6rem; max-width: 52ch; }
  .srvi-extra-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 1.8rem; }
  .srvi-extra-tags span { padding: 5px 14px; border: 1px solid var(--line); color: var(--gold); font-size: .72rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; background: var(--white); }

  @media (max-width: 900px) {
    .srvi-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .srvi-grid { grid-template-columns: 1fr; }
  }
</style>
