---
import { Image } from 'astro:assets';
import monogramCream from '../assets/brand/li-monogram-cream.png';
import monogramNavy from '../assets/brand/li-monogram-navy.png';
import { navItems, site } from '../data/site';

const isHome = Astro.url.pathname === '/';
const a = (href: string) => href.startsWith('/') ? href : isHome ? href : `/${href}`;
---

<header class="site-header" data-header>
  <div class="shell header-shell">
    <a class="brand" href={isHome ? '#top' : '/'} aria-label="Legatum Internacional, inicio">
      <span class="brand-mark" aria-hidden="true">
        <Image src={monogramCream} alt="" width={34} height={42} class="mark-light" loading="eager" />
        <Image src={monogramNavy} alt="" width={34} height={42} class="mark-dark" loading="eager" />
      </span>
      <span class="wordmark"><strong>LEGATUM</strong><small>INTERNACIONAL</small></span>
    </a>

    <nav class="desktop-nav" aria-label="Principal">
      {navItems.map((item) => <a href={a(item.href)}>{item.label}</a>)}
      <a href="/blog/">Guías</a>
    </nav>

    <div class="header-actions">
      <a class="btn btn-small btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 5-1.3A10 10 0 1 0 12 2Zm5.6 14.1c-.2.6-1.4 1.2-1.9 1.2-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5-.3.4c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.5.4.1.1.1.7-.1 1.3Z"/></svg>
        Conversar
      </a>
      <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="mobile-menu" aria-hidden="true" data-mobile-menu>
  <div class="mobile-menu-head">
    <span class="wordmark"><strong>LEGATUM</strong><small>INTERNACIONAL</small></span>
    <button type="button" aria-label="Cerrar menú" data-menu-close>×</button>
  </div>
  <nav aria-label="Principal móvil">
    {navItems.map((item) => <a href={a(item.href)}>{item.label}</a>)}
    <a href="/blog/">Guías</a>
  </nav>
  <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Iniciar evaluación</a>
</div>
