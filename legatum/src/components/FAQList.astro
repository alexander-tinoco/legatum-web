---
import { faqs } from '../data/site';

interface Props { limit?: number; }
const { limit } = Astro.props;
const items = limit ? faqs.slice(0, limit) : faqs;
---

<div class="faq-list">
  {items.map((faq, index) => (
    <article class:list={['faq-item', { 'is-open': index === 0 }]}>
      <h3>
        <button type="button" aria-expanded={index === 0 ? 'true' : 'false'} aria-controls={`faq-${index}`} data-faq-trigger>
          {faq.question}
          <span aria-hidden="true"></span>
        </button>
      </h3>
      <div id={`faq-${index}`} class="faq-panel" data-faq-panel>
        <div class="faq-panel-inner">
          <p>{faq.answer}</p>
        </div>
      </div>
    </article>
  ))}
</div>
