---
import { services } from '../data/site';
---

<form class="contact-form" id="lead-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="10bdf0b7-464e-4943-a3c4-83c4cd8f8b70" />
  <input type="hidden" name="subject" value="Nueva consulta — Legatum Internacional" />
  <input type="hidden" name="from_name" value="Legatum Internacional Web" />
  <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" aria-hidden="true" />
  <div class="form-grid">
    <label>
      <span>Nombre completo</span>
      <input name="nombre" type="text" autocomplete="name" required />
    </label>
    <label>
      <span>Teléfono / WhatsApp</span>
      <input name="telefono" type="tel" autocomplete="tel" pattern={"[0-9 +\\(\\)\\-]{7,20}"} title="Ingrese un número de teléfono válido" required />
    </label>
    <label>
      <span>Correo electrónico</span>
      <input name="email" type="email" autocomplete="email" />
    </label>
    <label>
      <span>Servicio de interés</span>
      <select name="servicio" required>
        <option value="">Seleccione un servicio</option>
        {services.map((service) => <option value={service.title}>{service.title}</option>)}
        <option value="Otro">Otro destino / consulta</option>
      </select>
    </label>
    <label class="full">
      <span>Cuéntenos brevemente su situación</span>
      <textarea name="mensaje" rows="5"></textarea>
    </label>
  </div>
  <label class="consent-label">
    <input type="checkbox" name="consentimiento" required />
    <span>He leído y acepto el <a href="/aviso-de-privacidad/">Aviso de Privacidad</a>. Autorizo el tratamiento de mis datos para recibir orientación sobre mi caso.</span>
  </label>
  <div
    class="cf-turnstile"
    data-sitekey="0x4AAAAAADn-hcWQMz_l-Hv0"
    data-action="turnstile-spin-v1"
    data-theme="light"
  ></div>
  <div class="form-actions">
    <button class="btn btn-whatsapp" type="submit">Enviar y recibir orientación</button>
    <p>Sus datos se tratan con confidencialidad institucional. No compartimos su información.</p>
  </div>
  <p class="form-status" role="status" aria-live="polite" data-form-status></p>
</form>

<style>
  .form-grid label:has(input[required]) span::after,
  .form-grid label:has(select[required]) span::after,
  .form-grid label:has(textarea[required]) span::after {
    content: " *";
    color: #c62828;
  }
</style>

<script>
  const COOLDOWN_MS = 60 * 60 * 1000; // 1 hora
  const STORAGE_KEY = 'legatum_form_last_submit';

  const form = document.getElementById('lead-form') as HTMLFormElement;
  const status = form.querySelector('[data-form-status]') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;

  function setStatus(text: string, color: string) {
    status.textContent = text;
    status.style.color = color;
  }

  function isOnCooldown(): boolean {
    const last = localStorage.getItem(STORAGE_KEY);
    if (!last) return false;
    return Date.now() - parseInt(last, 10) < COOLDOWN_MS;
  }

  if (isOnCooldown()) {
    btn.disabled = true;
    setStatus('Ya nos enviaste un mensaje. Te contactaremos pronto.', 'var(--color-success, #2e7d32)');
  }

  const TURNSTILE_WORKER = 'https://turnstile-siteverify-legatum.alexander-tinoco-gh.workers.dev';

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (isOnCooldown()) return;

    const token = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;
    if (!token) {
      setStatus('Por favor, complete el desafío de verificación.', 'var(--color-error, #c62828)');
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Verificando…';
    setStatus('', '');

    try {
      const verify = await fetch(TURNSTILE_WORKER, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      const vData = await verify.json();
      if (!vData.success) {
        setStatus('Verificación fallida. Actualice la página e intente de nuevo.', 'var(--color-error, #c62828)');
        btn.disabled = false;
        btn.textContent = 'Enviar y recibir orientación';
        return;
      }
    } catch {
      setStatus('Error de verificación. Intente de nuevo.', 'var(--color-error, #c62828)');
      btn.disabled = false;
      btn.textContent = 'Enviar y recibir orientación';
      return;
    }

    btn.textContent = 'Enviando…';

    try {
      // El token de Turnstile ya fue consumido al verificarlo con nuestro worker.
      // Enviarlo a web3forms causaría un segundo intento de verificación que falla.
      const formData = new FormData(form);
      formData.delete('cf-turnstile-response');

      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: formData,
      });
      const data = await res.json();

      if (data.success) {
        // A2 · evento de conversión de lead (frente A del roadmap).
        const servicio = (form.querySelector('[name="servicio"]') as HTMLSelectElement)?.value || 'general';
        (window as any).legatumTrack?.('generate_lead', { method: 'formulario', service: servicio });
        localStorage.setItem(STORAGE_KEY, String(Date.now()));
        setStatus('¡Mensaje enviado! Le contactaremos el mismo día hábil.', 'var(--color-success, #2e7d32)');
        form.reset();
      } else {
        throw new Error(data.message ?? 'Error desconocido');
      }
    } catch (err) {
      setStatus('Ocurrió un error al enviar. Intente de nuevo o escríbanos por WhatsApp.', 'var(--color-error, #c62828)');
      btn.disabled = false;
      btn.textContent = 'Enviar y recibir orientación';
    }
  });
</script>
