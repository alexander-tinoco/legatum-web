---
import { Image } from 'astro:assets';
import monogramCream from '../assets/brand/li-monogram-cream.png';
import { additionalDestinations, emailEntity, emailHref, services, site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const isHome = Astro.url.pathname === '/';
const a = (href: string) => href.startsWith('/') ? href : isHome ? href : `/${href}`;
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div class="footer-brand">
      <a class="brand" href={isHome ? '#top' : '/'}>
        <Image src={monogramCream} alt="" width={36} height={44} />
        <span class="wordmark"><strong>LEGATUM</strong><small>INTERNACIONAL</small></span>
      </a>
      <p>{site.description}</p>
      <SocialLinks class="footer-social" />
    </div>
    <div>
      <p class="footer-col-title">Servicios</p>
      <ul>
        {services.map((service) => <li><a href={`/servicios/${service.slug}/`}>{service.title}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Destinos</p>
      <ul>
        {additionalDestinations.map((destination) => <li><a href="/servicios/">{destination}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer-col-title">Firma</p>
      <ul>
        <li><a href="/servicios/">Servicios</a></li>
        <li><a href="/metodo/">Método</a></li>
        <li><a href="/nosotros/">Nosotros</a></li>
        <li><a href="/casos-de-exito/">Casos de éxito</a></li>
        <li><a href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
        <li><a href="/contacto/">Contacto</a></li>
        <li><a href="/blog/">Guías</a></li>
      </ul>
    </div>
    <div class="footer-contact">
      <p class="footer-col-title">Contacto</p>
      <a href={`tel:${site.phone}`}>{site.phoneDisplay}</a>
      <a href={emailHref} set:html={emailEntity}></a>
      <span>{site.address}<br />Atención nacional y desde el extranjero</span>
      <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">Iniciar evaluación</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <p>© 2026 {site.name}. Movilidad internacional desde México.</p>
    <div>
      <a href="/aviso-de-privacidad/">Aviso de privacidad</a>
      <a href="/terminos/">Términos</a>
    </div>
  </div>
</footer>
