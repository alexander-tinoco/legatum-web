---
import SectionHeader from '../components/SectionHeader.astro';
import { caseStudies, testimonials } from '../data/site';
---

<section class="section section-cream cases" id="casos">
  <div class="shell">
    <SectionHeader
      eyebrow="Casos reales"
      title="Situación, proceso y resultado."
      lead="Expedientes anonimizados que muestran cómo trabajamos: entender el caso, ejecutar con precisión y acompañar hasta la resolución."
    />
    <div class="case-grid">
      {caseStudies.map((item, index) => (
        <article class={`reveal${index > 0 ? ` d${Math.min(index, 3)}` : ''}`}>
          <span>{item.service}</span>
          <h3>{item.title}</h3>
          <dl>
            <div><dt>Situación</dt><dd>{item.situation}</dd></div>
            <div><dt>Proceso</dt><dd>{item.process}</dd></div>
            <div><dt>Resultado</dt><dd>{item.result}</dd></div>
          </dl>
          <p>Caso real anonimizado, {item.location}</p>
        </article>
      ))}
    </div>

    <div class="testimonial-section reveal d1">
      <span class="eyebrow">Lo que dicen nuestros clientes</span>
      <h3 class="testimonial-heading">Resultados reales, palabras reales.</h3>
      <div class="testimonial-grid">
        {testimonials.map((t, index) => (
          <figure class={`reveal${index > 0 ? ` d${Math.min(index, 3)}` : ''}`}>
            <div class="stars" role="img" aria-label="5 estrellas">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 12 12" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path d="M6 .5l1.5 3 3.3.5-2.4 2.3.6 3.2L6 8l-2.9 1.5.6-3.2L1.2 4l3.3-.5z"/>
                </svg>
              ))}
            </div>
            <blockquote>"{t.quote}"</blockquote>
            <figcaption>
              <strong>{t.author}</strong>
              <span>{t.context}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
