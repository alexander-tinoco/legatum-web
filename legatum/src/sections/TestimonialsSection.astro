---
import { testimonials } from '../data/site';
---

<section class="section section-cream testimonials">
  <div class="shell">
    <span class="eyebrow">Lo que dicen nuestros clientes</span>
    <h2 class="test-heading">Resultados reales, palabras reales.</h2>

    <div class="carousel" role="region" aria-label="Testimoniales de clientes">
      <div class="carousel-track" id="carousel-track">
        {testimonials.map((t, index) => (
          <figure
            class={`carousel-slide${index === 0 ? ' active' : ''}`}
            aria-hidden={index !== 0 ? 'true' : 'false'}
          >
            <div class="stars" role="img" aria-label="5 estrellas">
              {[...Array(5)].map(() => (
                <svg viewBox="0 0 12 12" width="14" height="14" fill="currentColor" aria-hidden="true">
                  <path d="M6 .5l1.5 3 3.3.5-2.4 2.3.6 3.2L6 8l-2.9 1.5.6-3.2L1.2 4l3.3-.5z"/>
                </svg>
              ))}
            </div>
            <blockquote>"{t.quote}"</blockquote>
            <figcaption>
              <strong>{t.author}</strong>
              <span>{t.context}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="carousel-controls">
        <button class="carousel-btn" id="carousel-prev" aria-label="Testimonio anterior">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <div class="carousel-dots">
          {testimonials.map((_, i) => (
            <button
              class={`carousel-dot${i === 0 ? ' active' : ''}`}
              aria-label={`Testimonio ${i + 1}`}
              data-index={String(i)}
            ></button>
          ))}
        </div>
        <button class="carousel-btn" id="carousel-next" aria-label="Siguiente testimonio">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .test-heading { margin-top: .3em; font-size: clamp(1.7rem, 3vw, 2.6rem); }

  .carousel { margin-top: clamp(32px, 4vw, 48px); }

  .carousel-slide {
    display: none;
    max-width: 720px;
    margin: 0 auto;
    padding: 48px;
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--gold);
  }
  .carousel-slide.active {
    display: block;
    animation: fadeSlideUp .35s var(--ease);
  }

  @keyframes fadeSlideUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .carousel-slide .stars { display: flex; gap: 3px; margin-bottom: 20px; color: var(--gold); }

  .carousel-slide blockquote {
    color: var(--navy);
    font-family: var(--serif);
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    line-height: 1.4;
  }

  .carousel-slide figcaption {
    display: grid;
    gap: 3px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .carousel-slide figcaption strong { color: var(--navy); font-size: .9rem; }
  .carousel-slide figcaption span { color: var(--muted); font-size: .82rem; }

  .carousel-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 28px;
  }

  .carousel-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--navy);
    cursor: pointer;
    transition: border-color .25s, background .25s, transform .2s var(--ease), color .25s;
  }
  .carousel-btn svg { transition: transform .2s var(--ease); }
  .carousel-btn:hover {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--white);
    transform: scale(1.08);
  }
  .carousel-btn:active { transform: scale(.93); }
  #carousel-prev:hover svg { transform: translateX(-3px); }
  #carousel-next:hover svg { transform: translateX(3px); }

  .carousel-dots { display: flex; gap: 8px; align-items: center; }

  .carousel-dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border: none;
    background: var(--line);
    cursor: pointer;
    padding: 0;
    overflow: hidden;
    transition: width .3s var(--ease), background .2s;
  }
  .carousel-dot.active {
    width: 28px;
    background: color-mix(in srgb, var(--gold) 35%, transparent);
  }
  .carousel-dot.active::after {
    content: '';
    position: absolute;
    inset: 0;
    width: 0;
    background: var(--gold);
    border-radius: inherit;
    animation: dotFill 10s linear forwards;
  }

  @keyframes dotFill {
    to { width: 100%; }
  }

  @media (max-width: 640px) {
    .carousel-slide { padding: 28px 20px; }
  }
</style>

<script>
  const track = document.getElementById('carousel-track');
  if (track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>('.carousel-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLElement>('.carousel-dot'));
    const carousel = track.closest('.carousel') as HTMLElement;
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('active');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current].classList.remove('active');

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('active');
      slides[current].setAttribute('aria-hidden', 'false');
      dots[current].classList.add('active');
    }

    function startTimer() {
      timer = setInterval(() => goTo(current + 1), 10000);
    }

    function resetTimer() {
      clearInterval(timer);
      startTimer();
    }

    document.getElementById('carousel-prev')?.addEventListener('click', () => { goTo(current - 1); resetTimer(); });
    document.getElementById('carousel-next')?.addEventListener('click', () => { goTo(current + 1); resetTimer(); });
    dots.forEach((dot, i) => dot.addEventListener('click', () => { goTo(i); resetTimer(); }));

    carousel?.addEventListener('mouseenter', () => clearInterval(timer));
    carousel?.addEventListener('mouseleave', startTimer);

    startTimer();
  }
</script>
