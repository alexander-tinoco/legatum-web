---
import { Picture } from 'astro:assets';
import heroImage from '../assets/brand/hero-arquitectura.png';
import WaIcon from '../components/WaIcon.astro';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Picture
    src={heroImage}
    alt="Arquitectura institucional con columnas iluminadas"
    class="hero-image"
    widths={[480, 768, 1200, 1672]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>

  <svg class="hero-sig" viewBox="0 0 320 420" aria-hidden="true">
    <line x1="160" y1="6" x2="160" y2="414" style="--len:420"></line>
    <line x1="160" y1="232" x2="312" y2="232" style="--len:160"></line>
    <line x1="160" y1="232" x2="44" y2="348" style="--len:170"></line>
    <circle cx="160" cy="232" r="4"></circle>
  </svg>

  <div class="shell hero-content">
    <span class="eyebrow">Firma de movilidad internacional · México</span>
    <h1 id="hero-title">Movilidad internacional con la <em>certeza</em> de una institución.</h1>
    <p>
      Visas, pasaportes y procesos consulares preparados con el rigor, la discreción y el criterio de una firma especializada. No tramitamos: respondemos por su caso.
    </p>
    <div class="hero-actions">
      <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="hero">
        <WaIcon />Inicie su evaluación
      </a>
      <a class="btn btn-ghost-light" href="/metodo/">Conozca el método</a>
    </div>
    <p class="hero-reassurance">Respuesta el mismo día hábil. Usted decide después. Sin compromiso.</p>
    <dl class="hero-metrics" aria-label="Indicadores de atención">
      <div><dt>100%</dt><dd>Honorarios claros<br>antes de iniciar</dd></div>
      <div><dt>24 h</dt><dd>Respuesta a su<br>primera consulta</dd></div>
    </dl>
  </div>

  <a class="scroll-cue" href="#servicios" aria-label="Conózcanos — desplácese">
    <span>Conózcanos</span>
    <span class="scroll-mouse"></span>
  </a>
</section>
