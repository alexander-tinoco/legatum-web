---
import { Picture } from 'astro:assets';
import heroImage from '../assets/brand/hero-arquitectura.png';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Picture
    src={heroImage}
    alt="Arquitectura institucional con columnas iluminadas"
    class="hero-image"
    widths={[480, 768, 1200, 1672]}
    sizes="100vw"
    formats={['avif', 'webp']}
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay"></div>

  <svg class="hero-sig" viewBox="0 0 320 420" aria-hidden="true">
    <line x1="160" y1="6" x2="160" y2="414" style="--len:420"></line>
    <line x1="160" y1="232" x2="312" y2="232" style="--len:160"></line>
    <line x1="160" y1="232" x2="44" y2="348" style="--len:170"></line>
    <circle cx="160" cy="232" r="4"></circle>
  </svg>

  <div class="shell hero-content">
    <span class="eyebrow">Firma de movilidad internacional, con base en México</span>
    <h1 id="hero-title">Movilidad internacional con la <em>certeza</em> de una institución.</h1>
    <p>
      Visas, pasaportes y trámites consulares con la seriedad y discreción de una firma especializada. A donde necesite llegar.
    </p>
    <div class="hero-actions">
      <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 5-1.3A10 10 0 1 0 12 2Zm5.6 14.1c-.2.6-1.4 1.2-1.9 1.2-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.7-.6-3-1.3-4.9-4.3-5-4.5-.2-.2-1.2-1.6-1.2-3s.7-2.1 1-2.4c.2-.3.5-.4.7-.4h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.5-.3.4c-.2.2-.3.4-.1.7.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.7-.1l.9-1c.2-.3.4-.2.7-.1l2 .9c.3.2.5.2.5.4.1.1.1.7-.1 1.3Z"/></svg>
        Inicie su evaluación
      </a>
      <a class="btn btn-ghost-light" href="/servicios/">Ver servicios</a>
    </div>
    <dl class="hero-metrics" aria-label="Indicadores de atención">
      <div><dt>100%</dt><dd>Honorarios claros<br>antes de iniciar</dd></div>
      <div><dt>24 h</dt><dd>Respuesta a su<br>primera consulta</dd></div>
    </dl>
  </div>

  <a class="scroll-cue" href="#servicios" aria-label="Conózcanos — desplácese">
    <span>Conózcanos</span>
    <span class="scroll-mouse"></span>
  </a>
</section>
