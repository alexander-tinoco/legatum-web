---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { services, site } from '../data/site';
---

<BaseLayout
  title={`Página no encontrada | ${site.name}`}
  description="La página que busca no existe o cambió de dirección. Vuelva al inicio o explore nuestros servicios de movilidad internacional."
  canonical={`${site.url}/404/`}
>
  <Navbar />
  <main id="main-content">
    <section class="nf-hero section-navy">
      <div class="shell">
        <span class="eyebrow nf-ey">Error 404</span>
        <h1 class="nf-h1e">Esta página no existe.</h1>
        <p class="nf-lead">
          La dirección que buscaba cambió o nunca existió. No se preocupe: desde aquí
          puede volver al inicio, ver nuestros servicios o escribirnos directamente.
        </p>
        <div class="nf-actions nf-act">
          <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer" data-wa-location="404">
            Iniciar mi evaluación
          </a>
          <a class="btn btn-ghost-light" href="/">Volver al inicio</a>
        </div>
      </div>
    </section>

    <section class="section section-paper">
      <div class="shell">
        <span class="eyebrow">Nuestros servicios</span>
        <h2 class="nf-h2">Quizá buscaba alguno de estos</h2>
        <div class="nf-grid">
          {services.map((s, i) => (
            <a class={`nf-card reveal${i > 0 ? ` d${Math.min(i % 3, 3)}` : ''}`} href={`/servicios/${s.slug}/`}>
              <span class="nf-flag" aria-hidden="true">{s.flag}</span>
              <strong>{s.title}</strong>
              <span class="nf-desc">{s.megaDesc}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .nf-hero {
    padding-top: calc(var(--header) + clamp(56px, 9vw, 110px));
    padding-bottom: clamp(56px, 9vw, 110px);
    border-bottom: 1px solid var(--line-light);
  }
  .nf-ey   { animation: hero-enter .65s var(--ease) .1s both; }
  .nf-h1e  { animation: hero-enter .75s var(--ease) .26s both; }
  .nf-lead { animation: hero-enter .65s var(--ease) .44s both; }
  .nf-act  { animation: hero-enter .6s var(--ease) .62s both; }
  .nf-hero .eyebrow { color: var(--gold-300); }
  .nf-hero h1 { color: var(--white); font-size: clamp(2.4rem, 6vw, 4.4rem); margin-top: .35em; }
  .nf-lead {
    max-width: 56ch;
    margin-top: 1.1rem;
    color: rgba(245, 240, 232, .82);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.6;
  }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2rem; }
  .nf-h2 { margin-top: .35em; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .nf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: clamp(28px, 4vw, 44px); }
  .nf-card { display: flex; flex-direction: column; gap: 8px; padding: 24px; background: var(--white); border: 1px solid var(--line); border-top: 2px solid transparent; transition: border-color .2s, transform .2s; }
  .nf-card:hover { border-top-color: var(--gold); transform: translateY(-3px); }
  .nf-flag { font-size: 1.4rem; }
  .nf-card strong { color: var(--navy); font-family: var(--serif); font-size: 1.3rem; font-weight: 600; }
  .nf-desc { color: var(--muted); font-size: .9rem; line-height: 1.45; }
  @media (max-width: 900px) { .nf-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .nf-grid { grid-template-columns: 1fr; } }
</style>
