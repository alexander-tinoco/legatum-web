---
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fees, processSteps, services, site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props;
const canonical = `${site.url}/servicios/${service.slug}/`;
const others = services.filter((s) => s.slug !== service.slug);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: service.title,
      serviceType: service.title,
      description: service.metaDescription,
      url: canonical,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: ['MX', 'United States', 'Canada'],
      offers: {
        '@type': 'Offer',
        priceCurrency: 'MXN',
        price: `${fees.minMXN}-${fees.maxMXN}`,
        priceSpecification: {
          '@type': 'PriceSpecification',
          minPrice: fees.minMXN,
          maxPrice: fees.maxMXN,
          priceCurrency: 'MXN',
        },
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      mainEntity: service.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<BaseLayout title={service.metaTitle} description={service.metaDescription} canonical={canonical}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Navbar />
  <main id="main-content">
    <section class="svc-hero section-navy">
      <div class="shell">
        <Breadcrumb
          crumbs={[{ label: 'Servicios', href: '/servicios/' }, { label: service.title }]}
          variant="dark"
        />
        <span class="eyebrow"><span aria-hidden="true">{service.flag}</span> Servicio de movilidad internacional</span>
        <h1>{service.title}</h1>
        <p class="svc-intro">{service.intro}</p>
        <div class="svc-actions">
          <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            Iniciar mi evaluación
          </a>
          <a class="btn btn-ghost-light" href="/#contacto">Dejar mis datos</a>
        </div>
      </div>
    </section>

    <section class="section section-paper">
      <div class="shell svc-body">
        <div class="svc-main">
          <div class="svc-block">
            <h2>Qué incluye este servicio</h2>
            <ul class="svc-list">
              {service.includes.map((item) => <li>{item}</li>)}
            </ul>
          </div>

          <div class="svc-block">
            <h2>Cómo trabajamos su caso</h2>
            <ol class="svc-steps">
              {processSteps.map((step) => (
                <li>
                  <strong>{step.title}</strong>
                  <span>{step.text}</span>
                </li>
              ))}
            </ol>
          </div>

          {service.faqs.length > 0 && (
            <div class="svc-block">
              <h2>Preguntas frecuentes</h2>
              <dl class="svc-faq">
                {service.faqs.map((f) => (
                  <div>
                    <dt>{f.question}</dt>
                    <dd>{f.answer}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>

        <aside class="svc-aside">
          <div class="svc-card">
            <p class="svc-card-label">Honorarios de referencia</p>
            <p class="svc-fee">{fees.display}</p>
            <p class="svc-fee-usd">{fees.displayUSD}</p>
            <p class="svc-fee-note">{fees.note}</p>
            <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
              Conversar por WhatsApp
            </a>
          </div>

          {service.requirements.length > 0 && (
            <div class="svc-card svc-card--plain">
              <p class="svc-card-label">Documentación base</p>
              <ul class="svc-req">
                {service.requirements.map((req) => <li>{req}</li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </section>

    <section class="section section-cream svc-others">
      <div class="shell">
        <span class="eyebrow">Otros servicios</span>
        <h2>Explore el resto de nuestras especialidades</h2>
        <div class="svc-others-grid">
          {others.map((s) => (
            <a class="svc-other-card" href={`/servicios/${s.slug}/`}>
              <span class="svc-flag" aria-hidden="true">{s.flag}</span>
              <strong>{s.title}</strong>
              <span class="svc-other-desc">{s.megaDesc}</span>
              <span class="svc-other-link">Ver el servicio →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .svc-hero {
    padding-top: calc(var(--header) + clamp(40px, 6vw, 72px));
    padding-bottom: clamp(48px, 7vw, 84px);
    border-bottom: 1px solid var(--line-light);
  }
  .svc-hero .bc { margin-bottom: 1.4rem; }
  .svc-hero .eyebrow { color: var(--gold-300); margin-top: 1.2rem; }
  .svc-hero h1 { color: var(--white); font-size: clamp(2.3rem, 5vw, 3.9rem); margin-top: .35em; max-width: 18ch; }
  .svc-intro { max-width: 60ch; margin-top: 1.1rem; color: rgba(245, 240, 232, .82); font-size: clamp(1.05rem, 1.6vw, 1.25rem); line-height: 1.6; }
  .svc-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 2rem; }

  .svc-body { display: grid; grid-template-columns: 1fr 320px; gap: clamp(36px, 5vw, 72px); align-items: start; }
  .svc-block + .svc-block { margin-top: clamp(40px, 5vw, 64px); }
  .svc-block h2 { font-size: clamp(1.5rem, 2.6vw, 2.1rem); margin-bottom: 1.1rem; }

  .svc-list { display: grid; gap: 12px; }
  .svc-list li { position: relative; padding-left: 1.9rem; color: var(--ink); line-height: 1.55; }
  .svc-list li::before { content: ""; position: absolute; left: 0; top: .55em; width: 14px; height: 1px; background: var(--gold); }

  .svc-steps { display: grid; gap: 18px; counter-reset: step; }
  .svc-steps li { display: grid; grid-template-columns: auto 1fr; gap: .35rem 1rem; padding-bottom: 18px; border-bottom: 1px solid var(--line); counter-increment: step; }
  .svc-steps li::before { content: counter(step, decimal-leading-zero); grid-row: span 2; font-family: var(--serif); font-size: 1.5rem; color: var(--gold); }
  .svc-steps strong { color: var(--navy); font-family: var(--serif); font-size: 1.2rem; font-weight: 600; }
  .svc-steps span { color: var(--muted); line-height: 1.55; }

  .svc-faq > div { padding: 18px 0; border-bottom: 1px solid var(--line); }
  .svc-faq dt { color: var(--navy); font-family: var(--serif); font-size: 1.18rem; font-weight: 600; margin-bottom: .5rem; }
  .svc-faq dd { margin: 0; color: var(--muted); line-height: 1.6; }

  .svc-aside { position: sticky; top: calc(var(--header) + 28px); display: grid; gap: 18px; }
  .svc-card { padding: 28px; background: var(--navy); color: var(--cream); border-top: 2px solid var(--gold); }
  .svc-card--plain { background: var(--white); color: var(--ink); border: 1px solid var(--line); border-top: 2px solid var(--gold); }
  .svc-card-label { font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--gold-300); }
  .svc-card--plain .svc-card-label { color: #7c6549; }
  .svc-fee { font-family: var(--serif); font-size: 2rem; font-weight: 600; margin-top: .6rem; color: var(--white); }
  .svc-fee-usd { color: var(--gold-300); font-size: .92rem; margin-top: .2rem; }
  .svc-fee-note { color: rgba(245, 240, 232, .68); font-size: .82rem; line-height: 1.5; margin-top: 1rem; }
  .svc-card .btn { margin-top: 1.4rem; width: 100%; }
  .svc-req { display: grid; gap: 10px; margin-top: 1rem; }
  .svc-req li { position: relative; padding-left: 1.4rem; color: var(--ink); font-size: .95rem; line-height: 1.5; }
  .svc-req li::before { content: ""; position: absolute; left: 0; top: .5em; width: 8px; height: 8px; border: 1px solid var(--gold); }

  .svc-others .eyebrow { color: #7c6549; }
  .svc-others h2 { margin-top: .35em; font-size: clamp(1.6rem, 3vw, 2.4rem); }
  .svc-others-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: clamp(28px, 4vw, 44px); }
  .svc-other-card { display: flex; flex-direction: column; gap: 8px; padding: 24px; background: var(--white); border: 1px solid var(--line); border-top: 2px solid transparent; transition: border-color .2s, transform .2s; }
  .svc-other-card:hover { border-top-color: var(--gold); transform: translateY(-3px); }
  .svc-flag { font-size: 1.4rem; }
  .svc-other-card strong { color: var(--navy); font-family: var(--serif); font-size: 1.3rem; font-weight: 600; }
  .svc-other-desc { color: var(--muted); font-size: .9rem; line-height: 1.45; flex: 1; }
  .svc-other-link { color: var(--gold); font-size: .82rem; font-weight: 650; letter-spacing: .04em; margin-top: .4rem; }

  @media (max-width: 900px) {
    .svc-body { grid-template-columns: 1fr; }
    .svc-aside { position: static; }
    .svc-others-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .svc-others-grid { grid-template-columns: 1fr; }
  }
</style>
