---
import Breadcrumb from '../components/Breadcrumb.astro';
import FAQList from '../components/FAQList.astro';
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { faqs, site } from '../data/site';

const canonical = `${site.url}/preguntas-frecuentes/`;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faqpage`,
      url: canonical,
      name: `Preguntas frecuentes | ${site.name}`,
      isPartOf: { '@id': `${site.url}/#website` },
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={`Preguntas frecuentes | ${site.name}`}
  description="Respuestas claras y honestas sobre visas, pasaportes y trámites de movilidad internacional: garantías, costos, cobertura y cómo empezar con LEGATUM INTERNACIONAL."
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <Navbar />
  <main id="main-content">
    <section class="faq-hero section-navy">
      <div class="shell">
        <Breadcrumb crumbs={[{ label: 'Preguntas frecuentes' }]} variant="dark" />
        <span class="eyebrow">Preguntas frecuentes</span>
        <h1>Lo que conviene saber antes de empezar.</h1>
        <p class="faq-lead">
          Reunimos las dudas que más nos plantean sobre visas, pasaportes y trámites consulares.
          Respuestas directas, sin promesas falsas. ¿No encuentra la suya? La resolvemos hoy por WhatsApp.
        </p>
      </div>
    </section>

    <section class="section section-paper">
      <div class="shell faq-page-wrap">
        <a class="page-back" href="/">← Inicio</a>
        <FAQList />
        <div class="faq-page-cta">
          <p>¿Su pregunta no está aquí? Cuéntenos su caso y le respondemos con honestidad el mismo día hábil.</p>
          <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
            Preguntar mi caso por WhatsApp
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .faq-hero {
    background: var(--navy);
    color: var(--cream);
    padding-top: calc(var(--header) + clamp(52px, 7vw, 84px));
    padding-bottom: clamp(52px, 7vw, 84px);
    border-bottom: 1px solid var(--line-light);
  }
  .faq-hero .bc { margin-bottom: 1.4rem; }
  .faq-hero .eyebrow { color: var(--gold-300); }
  .faq-hero h1 {
    color: var(--white);
    font-size: clamp(2.3rem, 5vw, 3.8rem);
    max-width: 20ch;
    margin-top: .35em;
    line-height: 1.1;
  }
  .faq-lead {
    max-width: 60ch;
    margin-top: 1.1rem;
    color: rgba(245, 240, 232, .82);
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  .faq-page-wrap { max-width: 820px; margin-inline: auto; }
  .faq-page-cta {
    margin-top: clamp(36px, 5vw, 56px);
    padding: clamp(28px, 4vw, 40px);
    background: var(--cream);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    text-align: center;
  }
  .faq-page-cta p {
    color: var(--muted);
    line-height: 1.65;
    max-width: 52ch;
    margin: 0 auto 1.4rem;
  }
</style>
