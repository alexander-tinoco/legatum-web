---
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const canonical = `${site.url}/herramientas/simulador-visa/`;
const phone = site.phone.replace('+', '');
---

<BaseLayout
  title={`Simulador de Visa Americana — ¿Cuántas probabilidades tienes? | ${site.name}`}
  description="Responde 10 preguntas basadas en los factores reales que evalúa el oficial consular y recibe un diagnóstico de tu perfil: probabilidad estimada, fortalezas y áreas críticas."
  canonical={canonical}
>
  <Navbar />
  <main id="main-content" class="sv-main">

    <!-- ── BREADCRUMB ────────────────────────────────── -->
    <div class="sv-breadcrumb">
      <a href="/herramientas/" class="sv-bc-link">← Herramientas</a>
    </div>

    <!-- ── INTRO ─────────────────────────────────────── -->
    <div id="sv-intro" class="sv-screen sv-active">
      <div class="sv-intro-wrap">
        <span class="sv-eyebrow">Herramienta gratuita · Legatum Internacional</span>
        <h1 class="sv-intro-title">¿Cuántas probabilidades tienes de obtener tu visa americana?</h1>
        <p class="sv-intro-lead">
          Responde 10 preguntas basadas en los criterios reales que evalúa el oficial consular.
          Recibes un diagnóstico con probabilidad estimada, tus fortalezas específicas y los
          puntos críticos que podrían afectar tu caso.
        </p>
        <ul class="sv-pills">
          <li>10 preguntas</li>
          <li>Sin registro</li>
          <li>Resultado inmediato</li>
          <li>100% gratuito</li>
        </ul>
        <button id="sv-btn-start" class="btn sv-btn-start">Iniciar diagnóstico →</button>
        <p class="sv-fine">Orientativo — no constituye asesoría jurídica ni garantiza resultados consulares.</p>
      </div>
    </div>

    <!-- ── QUIZ ──────────────────────────────────────── -->
    <div id="sv-quiz" class="sv-screen" aria-hidden="true">
      <div class="sv-quiz-wrap">
        <div class="sv-topbar">
          <div
            class="sv-pbar-track"
            role="progressbar"
            aria-valuenow="0"
            aria-valuemin="0"
            aria-valuemax="100"
            id="sv-pbar-wrap"
          >
            <div class="sv-pbar-fill" id="sv-pbar"></div>
          </div>
          <span class="sv-step" id="sv-step" aria-live="polite">1 / 10</span>
        </div>
        <div class="sv-card">
          <div class="sv-dots" id="sv-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p class="sv-q" id="sv-q" aria-live="polite"></p>
          <div class="sv-opts" id="sv-opts" role="group" aria-label="Opciones"></div>
        </div>
      </div>
    </div>

    <!-- ── RESULTADO ─────────────────────────────────── -->
    <div id="sv-result" class="sv-screen" aria-hidden="true">
      <div class="sv-result-wrap">

        <!-- Cabecera -->
        <div class="sv-rhead">
          <div class="sv-gauge-wrap">
            <svg id="sv-gauge-svg" viewBox="0 0 120 120" aria-hidden="true">
              <circle class="sv-g-bg"   cx="60" cy="60" r="50" fill="none" stroke-width="9"/>
              <circle class="sv-g-ring" cx="60" cy="60" r="50" fill="none" stroke-width="9"
                stroke-dasharray="314.16" stroke-dashoffset="314.16"
                transform="rotate(-90 60 60)" id="sv-g-ring"/>
            </svg>
            <div class="sv-gauge-inner">
              <strong class="sv-pct" id="sv-pct">0%</strong>
              <span class="sv-pct-lbl">probabilidad</span>
            </div>
          </div>
          <div class="sv-rmeta">
            <span class="sv-badge" id="sv-badge">—</span>
            <p class="sv-rmsg" id="sv-rmsg"></p>
          </div>
        </div>

        <!-- Fortalezas -->
        <div class="sv-section sv-section--pos" id="sv-strengths-wrap">
          <h2 class="sv-section-title sv-pos-title">
            <span class="sv-section-icon" aria-hidden="true">✓</span>
            Fortalezas de tu perfil
          </h2>
          <div class="sv-factors" id="sv-strengths"></div>
        </div>

        <!-- Áreas críticas -->
        <div class="sv-section sv-section--neg" id="sv-improve-wrap">
          <h2 class="sv-section-title sv-neg-title">
            <span class="sv-section-icon" aria-hidden="true">!</span>
            Aspectos a fortalecer
          </h2>
          <div class="sv-factors" id="sv-improvements"></div>
        </div>

        <!-- Estrategias -->
        <div class="sv-plan" id="sv-plan-wrap">
          <div class="sv-plan-head">
            <span class="sv-eyebrow sv-plan-eyebrow">Próximos pasos</span>
            <h2 class="sv-plan-title">Tu plan de acción</h2>
            <p class="sv-plan-lead">
              Basado en tu perfil, estas son las acciones prioritarias antes de agendar tu cita consular.
            </p>
          </div>
          <div class="sv-plan-steps" id="sv-strategies"></div>
          <div class="sv-plan-cta">
            <p class="sv-plan-cta-text">
              Un especialista puede guiarte en cada uno de estos pasos, preparar tu expediente y
              entrenarte para la entrevista consular — sin que tengas que resolver esto solo.
            </p>
            <a id="sv-wa-plan" href="#" class="btn btn-whatsapp sv-cta-btn" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Hablar con un especialista
            </a>
            <button id="sv-retry" class="btn btn-ghost-light sv-retry">Repetir diagnóstico</button>
          </div>
        </div>

        <p class="sv-fine sv-fine--result">
          Este simulador es una herramienta de orientación basada en factores consulares conocidos.
          No constituye asesoría jurídica ni garantiza ningún resultado ante autoridades migratorias.
        </p>
      </div>
    </div>

  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style is:global>
  /* ── Variables locales ─────────────────────────── */
  :root {
    --sv-pos: #3dbf7b;
    --sv-neg: #e07b52;
    --sv-mid: #d4a017;
    --sv-card: rgba(255,255,255,.045);
    --sv-border: rgba(196,168,130,.18);
    --sv-text: rgba(245,240,232,.82);
    --sv-text-dim: rgba(245,240,232,.48);
  }

  /* ── Layout principal ──────────────────────────── */
  .sv-main {
    min-height: 100svh;
    background: var(--navy);
    display: flex;
    flex-direction: column;
    padding-top: var(--header);
  }

  /* Breadcrumb */
  .sv-breadcrumb {
    padding: 11px var(--gutter);
    border-bottom: 1px solid rgba(196,168,130,.1);
    flex-shrink: 0;
  }
  .sv-bc-link {
    font-size: .75rem;
    font-weight: 650;
    letter-spacing: .04em;
    color: var(--gold-300);
    text-decoration: none;
    transition: color .2s;
  }
  .sv-bc-link:hover { color: var(--white); }

  .sv-screen {
    display: none;
    width: 100%;
    flex: 1;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: clamp(48px, 7vw, 88px) var(--gutter) clamp(48px, 6vw, 72px);
  }
  .sv-screen.sv-active { display: flex; }
  #sv-intro { justify-content: center; }

  /* ── INTRO ─────────────────────────────────────── */
  .sv-intro-wrap {
    width: 100%;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
    animation: sv-in .5s ease both;
  }
  .sv-eyebrow {
    display: block;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--gold-300);
    margin-bottom: 1.4rem;
  }
  .sv-intro-title {
    color: var(--white);
    font-family: var(--serif);
    font-size: clamp(1.85rem, 4.2vw, 3rem);
    line-height: 1.1;
    max-width: none;
    margin: 0 0 1.2rem;
  }
  .sv-intro-lead {
    color: var(--sv-text);
    font-size: clamp(.97rem, 1.5vw, 1.12rem);
    line-height: 1.7;
    max-width: 52ch;
    margin: 0 auto 2.2rem;
  }
  .sv-pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0 0 2.4rem;
  }
  .sv-pills li {
    padding: 5px 13px;
    border: 1px solid rgba(196,168,130,.3);
    color: var(--gold-300);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .sv-btn-start {
    font-size: 1rem;
    min-height: 50px;
    padding: .85rem 2.2rem;
  }
  .sv-fine {
    margin-top: 1.2rem;
    font-size: .68rem;
    color: var(--sv-text-dim);
    letter-spacing: .03em;
  }

  /* ── QUIZ ──────────────────────────────────────── */
  .sv-quiz-wrap {
    width: 100%;
    max-width: 660px;
    animation: sv-in .4s ease both;
  }
  .sv-topbar {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 1.6rem;
  }
  .sv-pbar-track {
    flex: 1;
    height: 3px;
    background: rgba(196,168,130,.15);
    border-radius: 2px;
    overflow: hidden;
  }
  .sv-pbar-fill {
    height: 100%;
    background: var(--gold-300);
    border-radius: 2px;
    transition: width .55s var(--ease);
    width: 0%;
  }
  .sv-step {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--sv-text-dim);
    white-space: nowrap;
  }
  .sv-card {
    background: var(--sv-card);
    border: 1px solid var(--sv-border);
    padding: clamp(24px, 4vw, 44px);
  }

  /* dots de carga */
  .sv-dots {
    display: flex;
    gap: 6px;
    margin-bottom: 18px;
    height: 18px;
    align-items: center;
  }
  .sv-dots.sv-gone { display: none; }
  .sv-dots span {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--gold-300);
    opacity: .55;
    animation: sv-dot .9s ease-in-out infinite;
  }
  .sv-dots span:nth-child(2) { animation-delay: .18s; }
  .sv-dots span:nth-child(3) { animation-delay: .36s; }

  /* pregunta */
  .sv-q {
    color: var(--white);
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2.2vw, 1.45rem);
    line-height: 1.5;
    min-height: 2.8em;
    margin: 0 0 1.8rem;
  }
  .sv-cursor {
    display: inline-block;
    color: var(--gold-300);
    animation: sv-blink .7s ease infinite;
    margin-left: 1px;
  }

  /* opciones */
  .sv-opts {
    display: flex;
    flex-direction: column;
    gap: 9px;
    opacity: 0;
    transition: opacity .3s ease;
  }
  .sv-opts.sv-visible { opacity: 1; }
  .sv-opt {
    text-align: left;
    width: 100%;
    background: transparent;
    border: 1px solid rgba(196,168,130,.22);
    color: var(--sv-text);
    padding: 13px 16px;
    font-family: var(--sans);
    font-size: clamp(.84rem, 1.4vw, .94rem);
    line-height: 1.45;
    cursor: pointer;
    transition: background .16s, border-color .16s, color .16s;
    opacity: 0;
    animation: sv-opt-in .26s ease forwards;
  }
  .sv-opt:hover:not(:disabled) {
    background: rgba(196,168,130,.09);
    border-color: var(--gold-300);
    color: var(--white);
  }
  .sv-opt:disabled { cursor: default; }
  .sv-opt.sv-selected {
    background: rgba(196,168,130,.14);
    border-color: var(--gold-300);
    color: var(--white);
  }

  /* ── RESULTADO ─────────────────────────────────── */
  .sv-result-wrap {
    width: 100%;
    max-width: 720px;
    animation: sv-in .45s ease both;
  }

  /* Cabecera resultado */
  .sv-rhead {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: clamp(20px, 4vw, 36px);
    align-items: center;
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--sv-border);
  }

  /* Gauge */
  .sv-gauge-wrap {
    position: relative;
    width: 120px;
    height: 120px;
    flex-shrink: 0;
  }
  #sv-gauge-svg { width: 120px; height: 120px; display: block; }
  .sv-g-bg   { stroke: rgba(196,168,130,.13); }
  .sv-g-ring {
    stroke-linecap: round;
    transition: stroke-dashoffset 1.3s cubic-bezier(.25,.46,.45,.94),
                stroke .4s ease;
  }
  .sv-gauge-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .sv-pct {
    font-family: var(--serif);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1;
  }
  .sv-pct-lbl {
    font-size: .58rem;
    letter-spacing: .09em;
    text-transform: uppercase;
    color: var(--sv-text-dim);
    margin-top: 3px;
  }

  /* Badge nivel */
  .sv-badge {
    display: inline-block;
    padding: 4px 12px;
    border: 1px solid currentColor;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    margin-bottom: .8rem;
  }
  .sv-badge.sv-alto  { color: var(--sv-pos); }
  .sv-badge.sv-medio { color: var(--sv-mid); }
  .sv-badge.sv-bajo  { color: var(--sv-neg); }

  .sv-rmsg {
    color: var(--sv-text);
    font-size: clamp(.88rem, 1.4vw, 1rem);
    line-height: 1.7;
    margin: 0;
  }

  /* Secciones de factores */
  .sv-section {
    margin-bottom: 1.4rem;
    padding: clamp(20px, 3vw, 30px);
    border: 1px solid var(--sv-border);
    background: var(--sv-card);
  }
  .sv-section--pos { border-left: 3px solid var(--sv-pos); }
  .sv-section--neg { border-left: 3px solid var(--sv-neg); }
  .sv-section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--sans);
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .13em;
    text-transform: uppercase;
    margin: 0 0 1.4rem;
  }
  .sv-pos-title { color: var(--sv-pos); }
  .sv-neg-title { color: var(--sv-neg); }
  .sv-section-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: .72rem;
    font-style: normal;
    flex-shrink: 0;
  }
  .sv-pos-title .sv-section-icon { background: rgba(61,191,123,.15); color: var(--sv-pos); }
  .sv-neg-title .sv-section-icon { background: rgba(224,123,82,.15); color: var(--sv-neg); }

  /* factor individual */
  .sv-factors {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .sv-factor {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: 14px;
    align-items: start;
  }
  .sv-factor-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-top: 5px;
    flex-shrink: 0;
  }
  .sv-section--pos .sv-factor-dot { background: var(--sv-pos); }
  .sv-section--neg .sv-factor-dot { background: var(--sv-neg); }
  .sv-factor-title {
    display: block;
    font-weight: 700;
    color: var(--white);
    font-size: clamp(.86rem, 1.4vw, .95rem);
    margin-bottom: .35rem;
  }
  .sv-factor-desc {
    color: var(--sv-text);
    font-size: clamp(.82rem, 1.3vw, .9rem);
    line-height: 1.65;
    margin: 0;
  }

  /* ── PLAN DE ACCIÓN ────────────────────────────── */
  .sv-plan {
    margin-bottom: 1.4rem;
    border: 1px solid var(--sv-border);
    background: rgba(196,168,130,.04);
    overflow: hidden;
  }
  .sv-plan-head {
    padding: clamp(20px, 3vw, 32px) clamp(20px, 3vw, 32px) clamp(16px, 2vw, 24px);
    border-bottom: 1px solid var(--sv-border);
  }
  .sv-plan-eyebrow {
    display: block;
    margin-bottom: .8rem;
  }
  .sv-plan-title {
    font-family: var(--serif);
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    font-weight: 600;
    color: var(--white);
    margin: 0 0 .6rem;
  }
  .sv-plan-lead {
    color: var(--sv-text);
    font-size: clamp(.84rem, 1.4vw, .95rem);
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }

  /* steps */
  .sv-plan-steps {
    padding: clamp(16px, 2.5vw, 28px) clamp(20px, 3vw, 32px);
    display: flex;
    flex-direction: column;
  }
  .sv-strat {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    align-items: start;
    padding: clamp(16px, 2vw, 22px) 0;
    border-bottom: 1px solid rgba(196,168,130,.1);
  }
  .sv-strat:last-child { border-bottom: none; }
  .sv-strat-num {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--gold-300);
    opacity: .55;
    line-height: 1;
    padding-top: 3px;
  }
  .sv-strat-title {
    font-family: var(--sans);
    font-size: clamp(.88rem, 1.4vw, .97rem);
    font-weight: 700;
    color: var(--white);
    margin: 0 0 .4rem;
    line-height: 1.35;
  }
  .sv-strat-desc {
    color: var(--sv-text);
    font-size: clamp(.82rem, 1.3vw, .9rem);
    line-height: 1.65;
    margin: 0;
  }

  /* CTA dentro del plan */
  .sv-plan-cta {
    background: rgba(196,168,130,.07);
    border-top: 1px solid var(--sv-border);
    padding: clamp(20px, 3vw, 32px);
    text-align: center;
  }
  .sv-plan-cta-text {
    color: var(--sv-text);
    font-size: clamp(.85rem, 1.4vw, .95rem);
    line-height: 1.65;
    max-width: 52ch;
    margin: 0 auto 1.6rem;
  }
  .sv-cta-btn {
    font-size: .95rem;
    min-height: 52px;
    padding: .9rem 2rem;
    gap: 10px;
  }
  .sv-cta-btn svg { flex-shrink: 0; }
  .sv-retry {
    display: block;
    margin: 1rem auto 0;
    color: var(--sv-text-dim);
    border-color: rgba(196,168,130,.2);
    font-size: .82rem;
    min-height: 38px;
    padding: .5rem 1.2rem;
  }
  .sv-retry:hover { color: var(--white); border-color: rgba(196,168,130,.5); }

  .sv-fine--result {
    margin-top: 0;
    text-align: center;
    display: block;
  }

  /* ── Animaciones ───────────────────────────────── */
  @keyframes sv-in {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes sv-dot {
    0%,60%,100% { transform: translateY(0); }
    30%          { transform: translateY(-6px); opacity: 1; }
  }
  @keyframes sv-blink {
    0%,49% { opacity: 1; }
    50%,100%{ opacity: 0; }
  }
  @keyframes sv-opt-in {
    to { opacity: 1; }
  }

  /* ── Responsive ────────────────────────────────── */
  @media (max-width: 560px) {
    .sv-rhead {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .sv-gauge-wrap { margin: 0 auto; }
    .sv-strat { grid-template-columns: 28px 1fr; gap: 12px; }
    .sv-strat-num { font-size: 1.05rem; }
  }
</style>

<script define:vars={{ phone }}>
/* ── Preguntas ─────────────────────────────────────── */
const QS = [
  {
    key: 'trabajo',
    q: '¿Cuál es tu situación laboral actual en México?',
    opts: [
      { label: 'Empleado con contrato estable (2 o más años de antigüedad)', score: 8 },
