  ags:   { label: 'Aguascalientes',            traslado: 1600, note: 'Viaje a Guadalajara para biometría en VAC (~2h en bus)' },
  chi:   { label: 'Chihuahua',                 traslado: 2000, note: 'Viaje a Tijuana o CDMX para biometría en VAC' },
  cul:   { label: 'Culiacán',                  traslado: 2200, note: 'Viaje a Guadalajara o Tijuana para biometría en VAC' },
  dgo:   { label: 'Durango',                   traslado: 2500, note: 'Viaje a Guadalajara o Monterrey para biometría en VAC' },
  leo:   { label: 'León / Guanajuato',         traslado: 1200, note: 'Viaje a Guadalajara para biometría en VAC (~1.5h en bus)' },
  lp:    { label: 'La Paz / Los Cabos',        traslado: 3500, note: 'Vuelo a Tijuana o CDMX + hospedaje para biometría' },
  lmo:   { label: 'Los Mochis',                traslado: 2800, note: 'Viaje a Guadalajara o Tijuana para biometría en VAC' },
  maz:   { label: 'Mazatlán',                  traslado: 2000, note: 'Viaje a Guadalajara para biometría en VAC (~5h en bus)' },
  mor:   { label: 'Cuernavaca / Morelos',      traslado: 800,  note: 'Viaje a CDMX para biometría en VAC (~1.5h en bus)' },
  oax:   { label: 'Oaxaca',                    traslado: 2000, note: 'Viaje a CDMX para biometría en VAC (~5h en bus)' },
  pue:   { label: 'Puebla',                    traslado: 900,  note: 'Viaje a CDMX para biometría en VAC (~2h en bus)' },
  qro:   { label: 'Querétaro',                 traslado: 1200, note: 'Viaje a CDMX para biometría en VAC (~3h en bus)' },
  sal:   { label: 'Saltillo',                  traslado: 700,  note: 'Viaje a Monterrey para biometría en VAC (~1.5h en bus)' },
  slp:   { label: 'San Luis Potosí',           traslado: 1800, note: 'Viaje a Monterrey o CDMX para biometría en VAC' },
  tam:   { label: 'Tampico',                   traslado: 1600, note: 'Viaje a Monterrey para biometría en VAC (~3h en bus)' },
  tor:   { label: 'Torreón / Gómez Palacio',   traslado: 1900, note: 'Viaje a Monterrey para biometría en VAC (~4h en bus)' },
  ver:   { label: 'Veracruz',                  traslado: 1500, note: 'Viaje a CDMX para biometría en VAC (~5h en bus)' },
  can:   { label: 'Cancún / Playa del Carmen', traslado: 2000, note: 'Vuelo a CDMX para biometría en VAC' },
  zac:   { label: 'Zacatecas',                 traslado: 2000, note: 'Viaje a Guadalajara para biometría en VAC (~4h en bus)' },
  otro:  { label: 'Otra ciudad',               traslado: 2500, note: 'Estimado promedio — incluye transporte al VAC más cercano' },
};

const IRCC_FEES = { trv: 3150, estudios: 2550, trabajo: 2635 };
const IRCC_LABELS = {
  trv:      'TRV Visitante (~CAD $185)',
  estudios: 'Permiso de Estudios (~CAD $150)',
  trabajo:  'Permiso de Trabajo (~CAD $155)',
};

const C = { mrv: 3500, biometria: 1450, vac: 1100, fotos: 100, pasaporte: 2590 };

const COPY = {
  ciudadHint: {
    americana:  'Lo usamos para estimar el traslado al consulado americano más cercano.',
    canadiense: 'Lo usamos para estimar el traslado al VAC (Centro de Solicitud de Visas de Canadá) más cercano.',
  },
  trasladoLabel: {
    americana:  'Traslado al consulado',
    canadiense: 'Traslado al VAC (biometría)',
  },
  disclaimer: {
    americana:  'Los montos son estimaciones de referencia en MXN. La tarifa MRV (~$185 USD) varía con el tipo de cambio. El especialista confirma el desglose exacto por escrito — antes de cualquier compromiso.',
    canadiense: 'Los montos son estimaciones de referencia en MXN. Las cuotas IRCC se pagan en CAD y varían con el tipo de cambio. El especialista confirma el desglose exacto por escrito — antes de cualquier compromiso.',
  },
};

const WA_LABELS = {
  pasaporte: { si: 'con pasaporte vigente', renovar: 'necesita renovar pasaporte', no: 'sin pasaporte' },
  tramite:   { primera: 'primera solicitud', renovacion: 'renovación de visa' },
  tipoCa:    { trv: 'TRV Visitante', estudios: 'Permiso de Estudios', trabajo: 'Permiso de Trabajo' },
  biometria: { nueva: 'primera solicitud (requiere biometría)', vigente: 'biometría vigente' },
};

// ── DOM REFS (cached once at init) ───────────────────────────────────────────

const layout       = document.querySelector('.cc-layout');
const form         = document.querySelector('.cc-form');
const elCiudad     = document.getElementById('cc-ciudad');
const elCityNote   = document.getElementById('cc-city-note');
const elCiudadHint = document.getElementById('cc-ciudad-hint');
const elLabelTras  = document.getElementById('cc-label-traslado');
const elSubTras    = document.getElementById('cc-sub-traslado');
const elValTras    = document.getElementById('cc-val-traslado');
const elSubIrcc    = document.getElementById('cc-sub-ircc');
const elValIrcc    = document.getElementById('cc-val-ircc');
const elSubBio     = document.getElementById('cc-sub-biometria');
const elValBio     = document.getElementById('cc-val-biometria');
const elSubPas     = document.getElementById('cc-sub-pasaporte');
const elValPas     = document.getElementById('cc-val-pasaporte');
const elTotal      = document.getElementById('cc-total');
const elCurrency   = document.getElementById('cc-total-currency');
const elDisclaimer = document.getElementById('cc-disclaimer');
const elWa         = document.getElementById('cc-wa');

// ── STATE ────────────────────────────────────────────────────────────────────

const state = { visa: null, ciudad: null, pasaporte: null, tramite: null, tipoCa: null, biometria: null };

// ── HELPERS ──────────────────────────────────────────────────────────────────

const fmt = n => '$' + n.toLocaleString('es-MX');

function setAmount(el, value, zeroText = null) {
  if (value === null) {
    el.textContent = '—';
    el.className   = 'cc-item-amount cc-pending';
  } else {
    el.textContent = (value === 0 && zeroText) ? zeroText : fmt(value);
    el.className   = 'cc-item-amount';
  }
}

function setTotal(base) {
  if (base === null) {
    elTotal.textContent    = '—';
    elCurrency.textContent = '';
  } else {
    elTotal.textContent    = `${fmt(base + honMin)} – ${fmt(base + honMax)}`;
    elCurrency.textContent = 'MXN · estimado referencial';
  }
}

// ── PURE FUNCTIONS ───────────────────────────────────────────────────────────

function pasaporteCosto() {
  if (state.pasaporte === 'si')     return 0;
  if (state.pasaporte)              return C.pasaporte;
  return null;
}

function buildWAMsg(city) {
  const cityLabel = city?.label ?? 'no especificada';
  if (state.visa === 'americana') {
    const pas  = WA_LABELS.pasaporte[state.pasaporte]  ?? 'no especificado';
    const tram = WA_LABELS.tramite[state.tramite]       ?? 'no especificado';
    return `Hola, usé la calculadora de Legatum para visa americana. Ciudad: ${cityLabel}, ${pas}, ${tram}. Me gustaría confirmar el costo exacto.`;
  }
  const tipo = WA_LABELS.tipoCa[state.tipoCa]    ?? 'no especificado';
  const bio  = WA_LABELS.biometria[state.biometria] ?? 'no especificado';
  return `Hola, usé la calculadora de Legatum para visa canadiense. Ciudad: ${cityLabel}, tipo: ${tipo}, ${bio}. Me gustaría confirmar el costo exacto.`;
}

// ── RENDER ───────────────────────────────────────────────────────────────────

function render() {
  if (!state.visa) return;

  const isCA   = state.visa === 'canadiense';
  const cities = isCA ? CITIES_CA : CITIES_US;
  const city   = state.ciudad ? cities[state.ciudad] : null;
  const pasCost = pasaporteCosto();

  // Modo CSS: una sola operación en el padre, el CSS hace todo el show/hide
  layout.classList.toggle('mode-americana',  !isCA);
  layout.classList.toggle('mode-canadiense', isCA);

  // Textos contextuales
  elCiudadHint.textContent = COPY.ciudadHint[state.visa];
  elLabelTras.textContent  = COPY.trasladoLabel[state.visa];
  elDisclaimer.textContent = COPY.disclaimer[state.visa];

  // Traslado
  elCityNote.textContent = city?.note ?? '';
  setAmount(elValTras, city?.traslado ?? null);
  elSubTras.textContent  = city?.note ?? 'Seleccione su ciudad';

  // Pasaporte
  const pasSub = { si: 'Ya cuentas con él', renovar: 'Pasaporte mexicano 10 años (estimado)', no: 'Pasaporte mexicano 10 años (estimado)' };
  setAmount(elValPas, pasCost, 'Incluido');
  elSubPas.textContent = pasSub[state.pasaporte] ?? 'Seleccione su situación';

  if (isCA) renderCA(city, pasCost);
  else      renderUS(city, pasCost);

  elWa.href = `https://wa.me/${phone}?text=${encodeURIComponent(buildWAMsg(city))}`;
}

function renderUS(city, pasCost) {
  const traslado = city?.traslado ?? null;
  const ready    = traslado !== null && pasCost !== null;
  setTotal(ready ? C.mrv + C.fotos + traslado + pasCost : null);
}

function renderCA(city, pasCost) {
  const irccCost = IRCC_FEES[state.tipoCa] ?? null;
  const bioCost  = state.biometria === 'nueva' ? C.biometria : state.biometria === 'vigente' ? 0 : null;
  const traslado = city?.traslado ?? null;

  setAmount(elValIrcc, irccCost);
  elSubIrcc.textContent = IRCC_LABELS[state.tipoCa] ?? 'Seleccione el tipo de visa';

  setAmount(elValBio, bioCost, 'No aplica');
  elSubBio.textContent = { nueva: 'Primera solicitud — ~CAD $85', vigente: 'Ya registrada y vigente' }[state.biometria] ?? 'Seleccione su situación';

  const ready = irccCost !== null && bioCost !== null && traslado !== null && pasCost !== null;
  setTotal(ready ? irccCost + (bioCost || 0) + C.vac + C.fotos + traslado + pasCost : null);
}

// ── EVENTS ───────────────────────────────────────────────────────────────────

elCiudad.addEventListener('change', e => {
  state.ciudad = e.target.value;
  render();
});

// Event delegation: un solo listener para todos los .cc-opt del formulario
form.addEventListener('click', e => {
  const opt = e.target.closest('.cc-opt[data-group]');
  if (!opt) return;

  const { group, value } = opt.dataset;

  // Deseleccionar anteriores del mismo grupo y marcar el actual
  form.querySelectorAll(`.cc-opt[data-group="${group}"]`).forEach(l => l.classList.remove('is-selected'));
  opt.classList.add('is-selected');

  // Al cambiar de tipo de visa, limpiar el estado específico del anterior
  if (group === 'visa' && value !== state.visa) {
    state.tramite   = null;
    state.tipoCa    = null;
    state.biometria = null;
    form.querySelectorAll('.cc-opt[data-group="tramite"], .cc-opt[data-group="tipoCa"], .cc-opt[data-group="biometria"]')
        .forEach(l => l.classList.remove('is-selected'));
  }

  state[group] = value;
  render();
});
</script>
