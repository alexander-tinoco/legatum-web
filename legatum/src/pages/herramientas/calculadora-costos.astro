  mty:   { label: 'Monterrey',                 traslado: 350,  note: 'VAC VFS Global en Monterrey — solo transporte local' },
  tij:   { label: 'Tijuana',                   traslado: 350,  note: 'VAC VFS Global en Tijuana — solo transporte local' },
  jua:   { label: 'Ciudad Juárez',             traslado: 900,  note: 'Viaje a Tijuana para biometría en VAC (~4h en bus)' },
  hmo:   { label: 'Hermosillo',                traslado: 1200, note: 'Viaje a Tijuana para biometría en VAC' },
