---
import ContactForm from '../../components/ContactForm.astro';
import WaIcon from '../../components/WaIcon.astro';
import LpLayout from '../../layouts/LpLayout.astro';
import { fees, services, site, testimonials, caseStudies } from '../../data/site';

const service = services.find((s) => s.slug === 'visa-americana')!;
const canonical = `${site.url}/lp/visa-americana/`;
const waUrl = `https://wa.me/526182706071?text=${encodeURIComponent('Hola, quiero evaluar mi caso para la visa americana B1/B2.')}`;

const caseStudy = caseStudies.find((c) => c.service === 'Visa Americana B1/B2')!;
const testimonial = testimonials[0];

const painPoints = [
  {
    tag: '01 — Arraigo',
    title: 'Arraigo mal construido',
    body: 'El consulado no aprueba visas a personas que no demuestran razones concretas para volver a México. Empleo, familia, propiedades: si no están documentados con coherencia, la solicitud cae.',
  },
  {
    tag: '02 — Formulario',
    title: 'DS-160 con inconsistencias',
    body: 'Un dato incorrecto, una fecha mal capturada o una respuesta que no coincide con su historial puede generar preguntas difíciles en la entrevista o comprometer el expediente completo.',
  },
  {
    tag: '03 — Entrevista',
    title: 'Entrevista sin preparación',
    body: 'El oficial tiene entre dos y cinco minutos. Si usted no sabe qué evalúa ni cómo responder con claridad, el expediente perfecto no sirve. Prepararse no es memorizar respuestas: es saber qué comunica cada una.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: 'Asesoría Visa Americana B1/B2',
      serviceType: 'Asesoría migratoria',
      description: service.metaDescription,
      url: canonical,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Mexico' },
      offers: { '@type': 'Offer', priceCurrency: 'MXN', price: `${fees.minMXN}-${fees.maxMXN}` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faqs.slice(0, 4).map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<LpLayout
  title="Asesoría Visa Americana B1/B2 | Expediente y Entrevista — Legatum Internacional"
  description="La visa americana no se gana llenando el DS-160. Se gana con el expediente correcto. Preparamos su caso: DS-160, arraigo y preparación para la entrevista consular."
  canonical={canonical}
  schema={schema}
  footerDisclaimer="Legatum Internacional es un servicio privado de consultoría en movilidad internacional. No somos una entidad gubernamental, no estamos afiliados al gobierno de Estados Unidos, México ni ningún otro país, y no garantizamos resultados ante autoridades consulares o migratorias. El pago de derechos consulares (MRV fee) se realiza directamente al gobierno correspondiente y no forma parte de nuestros honorarios."
  footerServiceHref="/servicios/visa-americana/"
  footerServiceLabel="Ver el servicio completo"
>

  <!-- ── HERO ── -->
  <section class="lp-hero section-navy">
    <div class="shell">
      <span class="eyebrow lp-ey">Visa Americana B1/B2 · Asesoría especializada</span>
      <h1 class="lp-h1">
        La visa americana no se gana<br />
        llenando un formulario.
      </h1>
      <p class="lp-hero-lead lp-lead-anim">
        Se gana demostrando que su vida está en México y que su viaje tiene un propósito claro.
        Preparamos su solicitud con el rigor de quien sabe qué evalúa realmente un oficial consular.
      </p>
      <div class="hero-actions">
        <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
          <WaIcon />Evaluar mi caso — sin costo
        </a>
      </div>
      <p class="hero-reassurance">Responde el especialista · Mismo día hábil · Sin compromiso</p>
      <dl class="hero-metrics">
        <div><dt>100&nbsp;%</dt><dd>Honorarios claros<br>antes de iniciar</dd></div>
        <div><dt>24&nbsp;h</dt><dd>Para su primera<br>respuesta</dd></div>
        <div><dt>10&nbsp;años</dt><dd>Vigencia de la<br>visa B1/B2</dd></div>
        <div><dt>$185&nbsp;USD</dt><dd>MRV fee —<br>no reembolsable</dd></div>
      </dl>
    </div>
  </section>

  <!-- ── POR QUÉ SE NIEGAN ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">El problema</span>
        <h2>Las 3 razones más comunes de negativa</h2>
        <p>La mayoría de las negativas no son por falta de dinero ni de viajes previos. Son prevenibles con la preparación correcta.</p>
      </div>
      <div class="trust-grid">
        {painPoints.map((p, i) => (
          <article class={`reveal${i > 0 ? ` d${Math.min(i, 3)}` : ''}`}>
            <span>{p.tag}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── MID CTA ── -->
  <div class="section-navy lp-mid-cta">
    <div class="shell lp-mid-cta-inner">
      <p>¿Alguna de esas situaciones aplica a su caso?</p>
      <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
        <WaIcon />Cuéntenos su situación
      </a>
      <span class="lp-mid-note">Sin compromiso — le orientamos hoy</span>
    </div>
  </div>

  <!-- ── QUÉ INCLUYE ── -->
  <section class="section section-cream">
    <div class="shell lp-svc-grid">
      <div>
        <div class="section-header">
          <span class="eyebrow">El servicio</span>
          <h2>Qué preparamos juntos</h2>
          <p>No administramos papeles. Analizamos su caso, definimos la estrategia y respondemos por cada decisión hasta el final.</p>
        </div>
        <ul class="credential-list lp-includes-list">
          {service.includes.map((item) => (
            <li><strong>{item}</strong></li>
          ))}
        </ul>
        <blockquote class="institutional-quote lp-guarantee">
          No garantizamos que le den la visa. La decisión es exclusiva del oficial consular. Desconfíe de quien lo prometa.
          Lo que sí está en nuestras manos —y es donde se gana o se pierde un caso— es que usted llegue con el expediente impecable, las respuestas claras y nada librado al azar.
          <cite>Una aclaración que hacemos desde el principio</cite>
        </blockquote>
      </div>
      <aside class="lp-fee-card">
        <p class="lp-fee-label">Honorarios de referencia</p>
        <p class="lp-fee-amount">{fees.display}</p>
        <p class="lp-fee-usd">{fees.displayUSD}</p>
        <hr class="lp-fee-divider" />
        <p class="lp-fee-frame">
          El MRV fee (derechos al consulado) son <strong>$185&nbsp;USD no reembolsables</strong>,
          independiente del resultado. Una solicitud mal preparada los pierde.
          Con el expediente correcto, ese mismo pago puede ser el inicio de
          10&nbsp;años de entradas a Estados Unidos.
        </p>
        <a class="btn btn-whatsapp lp-fee-cta" href={waUrl} target="_blank" rel="noopener noreferrer">
          <WaIcon />Iniciar mi evaluación
        </a>
        <p class="lp-fee-micro">El alcance y el honorario se confirman por escrito antes de contratar</p>
      </aside>
    </div>
  </section>

  <!-- ── CASO REAL ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">Resultado real</span>
        <h2>{caseStudy.title}</h2>
      </div>
      <div class="case-grid">
        <article class="reveal">
          <span>La situación</span>
          <p>{caseStudy.situation}</p>
        </article>
        <article class="reveal d1">
          <span>Lo que hicimos</span>
          <p>{caseStudy.process}</p>
        </article>
        <article class="lp-case-result reveal d2">
          <span>El resultado</span>
          <p>{caseStudy.result}</p>
        </article>
      </div>
      <blockquote class="institutional-quote lp-testi">
        "{testimonial.quote}"
        <cite>{testimonial.author} · {testimonial.context}</cite>
      </blockquote>
    </div>
  </section>

  <!-- ── CÓMO FUNCIONA ── -->
  <section class="section section-navy">
    <div class="shell">
      <div class="section-header invert">
        <span class="eyebrow">El proceso</span>
        <h2>Tres pasos. Sin sorpresas.</h2>
        <p>Sabemos qué falla en cada etapa. Por eso no dejamos nada al azar ni a última hora.</p>
      </div>
      <ul class="method-list">
        <li class="reveal">
          <span>01</span>
          <div>
            <h3>Análisis de viabilidad</h3>
            <p>Analizamos su caso y le decimos qué es posible, qué no y qué riesgos hay. Si su caso no tiene viabilidad real, se lo decimos antes de cobrar.</p>
          </div>
        </li>
        <li class="reveal d1">
          <span>02</span>
          <div>
            <h3>Preparación del expediente</h3>
            <p>Llenamos el DS-160 correcto, construimos el expediente de arraigo y definimos cada documento. Nada queda al azar ni a última hora.</p>
          </div>
        </li>
        <li class="reveal d2">
          <span>03</span>
          <div>
            <h3>Preparación para la entrevista</h3>
            <p>Simulamos la entrevista consular. Usted llega sabiendo qué evalúa el oficial, cómo responder con claridad y qué documentos mostrar en qué momento.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-cream">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que más nos preguntan</h2>
      </div>
      <div class="faq-list">
        {service.faqs.slice(0, 4).map((f, i) => (
          <article class:list={['faq-item', { 'is-open': i === 0 }]}>
            <h3>
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`lp-faq-${i}`} data-faq-trigger>
                {f.question}
                <span aria-hidden="true"></span>
              </button>
            </h3>
            <div id={`lp-faq-${i}`} class="faq-panel" data-faq-panel>
              <div class="faq-panel-inner">
                <p>{f.answer}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <section class="section section-navy lp-final">
    <div class="shell">
      <div class="lp-final-head">
        <span class="eyebrow">¿Listo para iniciar?</span>
        <h2>Cuéntenos su caso hoy.</h2>
        <p class="lp-final-lead">
          El mismo día hábil recibe una evaluación directa de su situación y los siguientes pasos.
          Sin compromiso. Sin costo inicial.
        </p>
      </div>
      <div class="lp-final-body">
        <div class="lp-final-left">
          <p class="lp-final-channel-label">Canal directo · WhatsApp</p>
          <a class="btn btn-whatsapp lp-final-wa" href={waUrl} target="_blank" rel="noopener noreferrer">
            <WaIcon />Hablar con el especialista
          </a>
          <p class="lp-final-wa-note">Le responde Alexander Tinoco directamente · Mismo día hábil</p>
          <ul class="lp-trust-list">
            <li><span aria-hidden="true">—</span> Sin costo por la primera orientación</li>
            <li><span aria-hidden="true">—</span> Le decimos directamente si su caso es viable</li>
            <li><span aria-hidden="true">—</span> El honorario se confirma por escrito antes de contratar</li>
            <li><span aria-hidden="true">—</span> Durango, México · Atención personalizada</li>
          </ul>
        </div>
        <div class="lp-final-form">
          <p class="lp-form-label">O déjenos sus datos y le contactamos nosotros</p>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

</LpLayout>

<style>
  .lp-case-result { background: var(--navy) !important; border-color: var(--navy) !important; }
  .lp-case-result > span { color: var(--gold-300) !important; }
  .lp-case-result > p { color: rgba(245,240,232,.82) !important; font-style: normal; }
  .lp-testi { margin-top: clamp(36px, 5vw, 56px); font-size: clamp(1.15rem, 2vw, 1.5rem); }
</style>
