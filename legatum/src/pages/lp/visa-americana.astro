---
import WaIcon from '../../components/WaIcon.astro';
import LpLayout from '../../layouts/LpLayout.astro';
import { fees, services, site } from '../../data/site';

const service = services.find((s) => s.slug === 'visa-americana')!;
const canonical = `${site.url}/lp/visa-americana/`;
const waUrl = `https://wa.me/526182706071?text=${encodeURIComponent('Hola, quiero evaluar mi caso gratis para la visa americana B1/B2.')}`;

const painPoints = [
  {
    tag: '01 — Falta de "Arraigo"',
    body: 'El consulado necesita pruebas concretas de que regresarás a México (empleo, familia, propiedades). Si no llevas los documentos correctos, tu visa será rechazada.',
  },
  {
    tag: '02 — Errores en el formulario DS-160',
    body: 'Un dato mal capturado o una fecha que no coincide puede generar preguntas difíciles en la ventanilla y hacer que el cónsul dude de ti.',
  },
  {
    tag: '03 — Ir a la entrevista sin preparación',
    body: 'El oficial tiene solo un par de minutos para evaluarte. Si te pones nervioso o no sabes qué contestar de forma clara, el expediente perfecto no sirve de nada.',
  },
];

const includes = [
  'Llenado correcto y sin errores del formulario DS-160.',
  'Armado de tu expediente: te decimos exactamente qué papeles llevar.',
  'Simulacro de entrevista: te preparamos para las preguntas del oficial.',
  'Revisión final de todos tus documentos antes de tu cita.',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: 'Asesoría Visa Americana B1/B2',
      serviceType: 'Asesoría migratoria',
      description: service.metaDescription,
      url: canonical,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Mexico' },
      offers: { '@type': 'Offer', priceCurrency: 'MXN', price: `${fees.minMXN}-${fees.maxMXN}` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faqs.slice(0, 5).map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<LpLayout
  title="Visa Americana B1/B2 | Asesoría paso a paso desde México — Legatum Internacional"
  description="Te preparamos para tu visa americana para que no pierdas tu dinero: DS-160, expediente de arraigo y simulacro de entrevista. Asesoría transparente desde México, sin precios inflados."
  canonical={canonical}
  schema={schema}
  whatsappUrl={waUrl}
  stickyLabel="Evaluar mi caso gratis"
  footerDisclaimer="Legatum Internacional es un servicio privado de consultoría en movilidad internacional. No somos una entidad gubernamental, no estamos afiliados al gobierno de Estados Unidos, México ni ningún otro país, y no garantizamos resultados ante autoridades consulares o migratorias. El pago de derechos consulares (MRV fee) se realiza directamente al gobierno correspondiente y no forma parte de nuestros honorarios."
  footerServiceHref="/servicios/visa-americana/"
  footerServiceLabel="Ver el servicio completo"
>

  <!-- ── HERO ── -->
  <section class="lp-hero section-navy">
    <div class="shell lp-hero-grid">
      <div>
        <span class="eyebrow lp-ey">Visa Americana B1/B2 · Asesoría paso a paso desde México</span>
        <h1 class="lp-h1">
          ¿Vas a tramitar tu visa americana? Te preparamos para que no pierdas tu dinero.
        </h1>
        <p class="lp-hero-lead lp-lead-anim">
          A diferencia de los costosos bufetes estadounidenses, en Legatum te ofrecemos asesoría
          experta y transparente desde México. Te guiamos en el formulario, armamos tu expediente
          y te preparamos para la entrevista consular. Sin complicaciones ni precios inflados.
        </p>
        <div class="hero-actions">
          <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
            <WaIcon />Evaluar mi caso gratis por WhatsApp →
          </a>
        </div>
        <p class="hero-reassurance">Te responde un especialista el mismo día · Sin compromiso</p>
      </div>

      <!-- VIDEO TESTIMONIO EN HERO (autoplay silenciado · clic para escuchar) -->
      <div class="lp-hero-video">
        <video src="/testimonio.mp4" autoplay muted loop playsinline controls preload="auto"></video>
        <p class="lp-hero-video-cap">▶ Testimonio real · toca para activar el sonido</p>
      </div>
    </div>
  </section>

  <!-- ── POR QUÉ RECHAZAN (El problema) ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">El problema</span>
        <h2>Las 3 razones por las que más rechazan la visa</h2>
      </div>
      <div class="trust-grid">
        {painPoints.map((p, i) => (
          <article class={`reveal${i > 0 ? ` d${Math.min(i, 3)}` : ''}`}>
            <span>{p.tag}</span>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
      <img src="/lp/ayuda.webp" alt="Persona preocupada revisando documentos de visa" class="lp-section-img reveal" width="1280" height="720" loading="lazy" />
    </div>
  </section>

  <!-- ── MID CTA ── -->
  <div class="section-navy lp-mid-cta">
    <div class="shell lp-mid-cta-inner">
      <p>¿Alguna de esas situaciones es la tuya?</p>
      <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
        <WaIcon />Cuéntanos tu caso
      </a>
      <span class="lp-mid-note">Sin compromiso — te orientamos hoy</span>
    </div>
  </div>

  <!-- ── CÓMO TE AYUDAMOS + PRECIO ── -->
  <section class="section section-cream">
    <div class="shell lp-svc-grid">
      <div>
        <div class="section-header">
          <span class="eyebrow">El servicio</span>
          <h2>Cómo te ayudamos a conseguirla</h2>
        </div>
        <ul class="credential-list lp-includes-list">
          {includes.map((item) => (
            <li><strong>{item}</strong></li>
          ))}
        </ul>
        <img src="/lp/rechazo.webp" alt="Especialista en visa americana asesorando a un cliente" class="lp-service-img reveal" width="1280" height="720" loading="lazy" />
      </div>

      <aside class="lp-fee-card">
        <p class="lp-fee-label">Honorarios transparentes</p>
        <p class="lp-fee-amount">{fees.display}</p>
        <p class="lp-fee-usd">{fees.displayUSD} · Sin sorpresas</p>
        <hr class="lp-fee-divider" />
        <p class="lp-fee-frame">
          <strong>Nota importante:</strong> el pago de derechos al consulado
          (<strong>$185 USD</strong>) es aparte y no es reembolsable.
          Una solicitud mal preparada te hace perder ese dinero.
        </p>
        <p class="lp-fee-frame" style="margin-top: 1rem;">
          ¿Por qué cobramos esto? No somos un inalcanzable bufete de abogados en Estados Unidos
          que cobra en dólares. Somos gestores en México brindando calidad institucional a precios justos.
        </p>
        <a class="btn btn-whatsapp lp-fee-cta" href={waUrl} target="_blank" rel="noopener noreferrer">
          <WaIcon />Evaluar mi caso gratis
        </a>
        <p class="lp-fee-micro">El alcance y el honorario se confirman por escrito antes de iniciar</p>
      </aside>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que más nos preguntan</h2>
      </div>
      <div class="faq-list">
        {service.faqs.slice(0, 5).map((f, i) => (
          <article class:list={['faq-item', { 'is-open': i === 0 }]}>
            <h3>
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`lp-faq-${i}`} data-faq-trigger>
                {f.question}
                <span aria-hidden="true"></span>
              </button>
            </h3>
            <div id={`lp-faq-${i}`} class="faq-panel" data-faq-panel>
              <div class="faq-panel-inner">
                <p>{f.answer}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <section class="section section-navy lp-final">
    <div class="shell lp-final-wa-only">
      <span class="eyebrow">¿Listo para empezar?</span>
      <h2>Evalúa tu caso gratis hoy.</h2>
      <p class="lp-final-lead">
        El mismo día hábil recibes una evaluación honesta de tu situación y los siguientes pasos.
        Sin compromiso. Sin costo inicial.
      </p>
      <a class="btn btn-whatsapp lp-final-wa" href={waUrl} target="_blank" rel="noopener noreferrer">
        <WaIcon />Evaluar mi caso gratis por WhatsApp →
      </a>
      <p class="lp-final-wa-note">Te responde un especialista directamente · Mismo día hábil</p>
      <ul class="lp-trust-list">
        <li><span aria-hidden="true">—</span> Sin costo por la primera orientación</li>
        <li><span aria-hidden="true">—</span> Te decimos con honestidad si tu caso es viable</li>
        <li><span aria-hidden="true">—</span> El honorario se confirma por escrito antes de iniciar</li>
        <li><span aria-hidden="true">—</span> Atención en tu idioma, desde México</li>
      </ul>
    </div>
  </section>

</LpLayout>
