---
import WaIcon from '../../components/WaIcon.astro';
import LpLayout from '../../layouts/LpLayout.astro';
import { fees, services, site } from '../../data/site';

const service = services.find((s) => s.slug === 'visa-canadiense')!;
const canonical = `${site.url}/lp/visa-canadiense/`;
const waUrl = `https://wa.me/526182706071?text=${encodeURIComponent('Hola, quiero evaluar mi caso gratis para la visa canadiense o eTA Canadá.')}`;

const painPoints = [
  {
    tag: '01 — Propósito de viaje confuso',
    body: 'Si tu itinerario de viaje no tiene sentido o es inconsistente con el tipo de visa que pides, la solicitud será denegada de inmediato.',
  },
  {
    tag: '02 — Fondos insuficientes',
    body: 'Debes demostrar que puedes costear tu viaje. No solo es tener dinero en el banco, es demostrar que el origen de ese dinero es legítimo y rastreable.',
  },
  {
    tag: '03 — Lazos débiles con México',
    body: 'Como no hay entrevista, tus documentos deben "hablar por ti" y convencer al oficial de que tienes razones fuertes (trabajo, familia) para regresar a casa.',
  },
];

const etaPoints = [
  'Cuesta CAD $7 y se aprueba en minutos',
  'Solo para vuelos directos a Canadá',
  'Requiere visa americana vigente o visa canadiense previa válida en los últimos 10 años',
  'No aplica si cruzas la frontera por tierra',
];

const visaPoints = [
  'Derechos consulares CAN $100 + biométricos CAN $85',
  'Resolución en 2 a 10 semanas',
  'Evaluación 100 % documental — no hay entrevista',
  'Válida para entradas múltiples según criterio del oficial',
];

const includes = [
  'Confirmamos si necesitas ETA o visa de visitante (TRV) para no perder tiempo ni dinero.',
  'Redactamos tu carta de explicación para demostrar el propósito de tu viaje.',
  'Organizamos la prueba de fondos y de tus vínculos con México.',
  'Completamos los formularios de IRCC y revisamos todo antes de enviar.',
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      '@id': `${canonical}#service`,
      name: 'Asesoría Visa Canadiense de Visitante',
      serviceType: 'Asesoría migratoria',
      description: service.metaDescription,
      url: canonical,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: { '@type': 'Country', name: 'Mexico' },
      offers: { '@type': 'Offer', priceCurrency: 'MXN', price: `${fees.minMXN}-${fees.maxMXN}` },
    },
    {
      '@type': 'FAQPage',
      mainEntity: service.faqs.slice(0, 5).map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
  ],
};
---

<LpLayout
  title="Visa Canadiense de Visitante | Trámite sin estrés desde México — Legatum Internacional"
  description="Te ayudamos con todo el papeleo de tu visa canadiense para que no te la rechacen. Construimos tu expediente para IRCC: propósito de viaje, fondos y vínculos con México. Sin tarifas infladas."
  canonical={canonical}
  schema={schema}
  whatsappUrl={waUrl}
  stickyLabel="Evaluar mi caso gratis"
  footerDisclaimer="Legatum Internacional es un servicio privado de consultoría en movilidad internacional. No somos una entidad gubernamental, no estamos afiliados al gobierno de Canadá, México ni ningún otro país, y no somos representantes de IRCC. Los derechos consulares se pagan directamente ante las autoridades canadienses y no forman parte de nuestros honorarios. No garantizamos resultados."
  footerServiceHref="/servicios/visa-canadiense/"
  footerServiceLabel="Ver el servicio completo"
>

  <!-- ── HERO ── -->
  <section class="lp-hero section-navy">
    <div class="shell lp-hero-grid">
      <div>
        <span class="eyebrow lp-ey">Visa Canadiense de Visitante · Trámite sin estrés</span>
        <h1 class="lp-h1">
          ¿Quieres viajar a Canadá? Te ayudamos con todo el papeleo para que no te la rechacen.
        </h1>
        <p class="lp-hero-lead lp-lead-anim">
          El gobierno de Canadá (IRCC) no hace entrevistas; solo evalúan los papeles que envías.
          Construimos un expediente perfecto para demostrar tu propósito de viaje y tus vínculos
          en México, sin cobrarte las exageradas tarifas de los abogados extranjeros.
        </p>
        <div class="hero-actions">
          <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
            <WaIcon />Evaluar mi caso gratis por WhatsApp →
          </a>
        </div>
        <p class="hero-reassurance">Te responde un especialista el mismo día · Sin compromiso</p>
      </div>

      <!-- VIDEO TESTIMONIO EN HERO (autoplay silenciado · clic para escuchar) -->
      <div class="lp-hero-video">
        <video src="/testimonio.mp4" autoplay muted loop playsinline controls preload="auto"></video>
        <p class="lp-hero-video-cap">▶ Testimonio real · toca para activar el sonido</p>
      </div>
    </div>
  </section>

  <!-- ── POR QUÉ NIEGAN (El problema) ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">El problema</span>
        <h2>Por qué el gobierno canadiense niega visas</h2>
      </div>
      <div class="trust-grid">
        {painPoints.map((p, i) => (
          <article class={`reveal${i > 0 ? ` d${Math.min(i, 3)}` : ''}`}>
            <span>{p.tag}</span>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
      <img src="/lp/ayuda.webp" alt="Persona preocupada revisando documentos de visa canadiense" class="lp-section-img reveal" width="1280" height="720" loading="lazy" />
    </div>
  </section>

  <!-- ── MID CTA ── -->
  <div class="section-navy lp-mid-cta">
    <div class="shell lp-mid-cta-inner">
      <p>¿Alguna de esas situaciones es la tuya?</p>
      <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
        <WaIcon />Cuéntanos tu caso
      </a>
      <span class="lp-mid-note">Sin compromiso — te orientamos hoy</span>
    </div>
  </div>

  <!-- ── CÓMO TE AYUDAMOS + PRECIO ── -->
  <section class="section section-cream">
    <div class="shell lp-svc-grid">
      <div>
        <div class="section-header">
          <span class="eyebrow">El servicio</span>
          <h2>Cómo te ayudamos con todo el papeleo</h2>
        </div>
        <ul class="credential-list lp-includes-list">
          {includes.map((item) => (
            <li><strong>{item}</strong></li>
          ))}
        </ul>
        <img src="/lp/rechazo.webp" alt="Especialista asesorando a cliente sobre visa canadiense" class="lp-service-img reveal" width="1280" height="720" loading="lazy" />
      </div>

      <aside class="lp-fee-card">
        <p class="lp-fee-label">Precio fijo y transparente</p>
        <p class="lp-fee-amount">{fees.display}</p>
        <p class="lp-fee-usd">{fees.displayUSD} · Sin sorpresas</p>
        <hr class="lp-fee-divider" />
        <p class="lp-fee-frame">
          <strong>Nota:</strong> las tarifas biométricas y consulares del gobierno de Canadá son aparte.
        </p>
        <p class="lp-fee-frame" style="margin-top: 1rem;">
          <strong>Atención experta desde México.</strong> Evita los costosos despachos de migración
          en inglés. Recibe atención experta en tu idioma y paga lo justo por un servicio de alta calidad.
        </p>
        <a class="btn btn-whatsapp lp-fee-cta" href={waUrl} target="_blank" rel="noopener noreferrer">
          <WaIcon />Evaluar mi caso gratis
        </a>
        <p class="lp-fee-micro">El alcance y el honorario se confirman por escrito antes de iniciar</p>
      </aside>
    </div>
  </section>

  <!-- ── ETA VS VISA (qué te aplica) ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">Antes de empezar</span>
        <h2>¿Necesitas visa de visitante o solo una ETA?</h2>
        <p>Muchos mexicanos inician el proceso equivocado. Lo primero que hacemos es confirmar cuál te aplica para no perder tiempo ni dinero.</p>
      </div>
      <div class="trust-grid lp-eta-grid">
        <article class="lp-eta-eta">
          <span>ETA — Autorización electrónica</span>
          <ul class="lp-eta-list">
            {etaPoints.map((item) => <li>{item}</li>)}
          </ul>
          <p class="lp-eta-note">Aplica si tienes visa americana vigente o visa canadiense de los últimos 10 años.</p>
        </article>
        <article class="lp-eta-visa">
          <span>Visa TRV — Visa de visitante</span>
          <ul class="lp-eta-list">
            {visaPoints.map((item) => <li>{item}</li>)}
          </ul>
          <p class="lp-eta-note">La evaluamos en la primera consulta y preparamos el expediente completo.</p>
        </article>
      </div>
      <div class="lp-eta-cta">
        <a class="btn btn-whatsapp" href={waUrl} target="_blank" rel="noopener noreferrer">
          <WaIcon />Confirmar cuál me aplica
        </a>
        <p>Sin compromiso — te orientamos hoy mismo</p>
      </div>
    </div>
  </section>

  <!-- ── FAQ ── -->
  <section class="section section-paper">
    <div class="shell">
      <div class="section-header">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Lo que más nos preguntan sobre Canadá</h2>
      </div>
      <div class="faq-list">
        {service.faqs.slice(0, 5).map((f, i) => (
          <article class:list={['faq-item', { 'is-open': i === 0 }]}>
            <h3>
              <button type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`ca-faq-${i}`} data-faq-trigger>
                {f.question}
                <span aria-hidden="true"></span>
              </button>
            </h3>
            <div id={`ca-faq-${i}`} class="faq-panel" data-faq-panel>
              <div class="faq-panel-inner">
                <p>{f.answer}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ── FINAL CTA ── -->
  <section class="section section-navy lp-final">
    <div class="shell lp-final-wa-only">
      <span class="eyebrow">¿Listo para empezar?</span>
      <h2>Evalúa tu caso gratis hoy.</h2>
      <p class="lp-final-lead">
        El mismo día hábil te decimos si te aplica ETA o visa, si conviene presentar
        y cuál es la ruta correcta para tu perfil. Sin compromiso.
      </p>
      <a class="btn btn-whatsapp lp-final-wa" href={waUrl} target="_blank" rel="noopener noreferrer">
        <WaIcon />Evaluar mi caso gratis por WhatsApp →
      </a>
      <p class="lp-final-wa-note">Te responde un especialista directamente · Mismo día hábil</p>
      <ul class="lp-trust-list">
        <li><span aria-hidden="true">—</span> Sin costo por la primera orientación</li>
        <li><span aria-hidden="true">—</span> Te confirmamos si necesitas ETA o visa TRV</li>
        <li><span aria-hidden="true">—</span> El honorario se confirma por escrito antes de iniciar</li>
        <li><span aria-hidden="true">—</span> Atención en tu idioma, desde México</li>
      </ul>
    </div>
  </section>

</LpLayout>

<style>
  .lp-eta-grid { grid-template-columns: 1fr 1fr; }
  .lp-eta-eta { border-top-color: #4a7c59 !important; }
  .lp-eta-list { display: grid; gap: 10px; margin-top: .9rem; }
  .lp-eta-list li { color: var(--ink); font-size: .9rem; line-height: 1.5; padding-left: 1.2rem; position: relative; }
  .lp-eta-list li::before { content: "→"; position: absolute; left: 0; color: var(--gold); font-size: .85rem; }
  .lp-eta-note { margin-top: 1.1rem; padding-top: .9rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .82rem; line-height: 1.55; font-style: italic; }
  .lp-eta-cta { display: flex; align-items: center; gap: 1.4rem; flex-wrap: wrap; margin-top: clamp(44px, 6vw, 64px); padding-top: clamp(32px, 4vw, 48px); border-top: 1px solid var(--line); }
  .lp-eta-cta p { color: var(--muted); font-size: .85rem; }

  @media (max-width: 760px) {
    .lp-eta-grid { grid-template-columns: 1fr; }
  }
</style>
