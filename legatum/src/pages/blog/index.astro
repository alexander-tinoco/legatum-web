---
import { getCollection } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Recursos y guías de movilidad internacional | LEGATUM INTERNACIONAL"
  description="Guías institucionales sobre visas, pasaportes y procesos consulares. Escritas por especialistas que han gestionado estos expedientes de primera mano."
  canonical={`${site.url}/blog/`}
>
  <Navbar />
  <main id="main-content">
    <section class="blog-hero section-navy">
      <div class="shell">
        <Breadcrumb crumbs={[{ label: 'Guías' }]} variant="dark" />
        <span class="eyebrow">Centro de conocimiento</span>
        <h1>Recursos para su proceso</h1>
        <p>Guías escritas por quien ha procesado estos expedientes de primera mano. Sin promesas optimistas ni relleno.</p>
      </div>
    </section>

    <section class="section section-paper blog-list">
      <div class="shell">
        <a class="blog-back" href="/">← Inicio</a>
        {posts.length === 0 ? (
          <p class="blog-empty">Próximamente. Los primeros recursos estarán disponibles en breve.</p>
        ) : (
          <div class="blog-grid">
            {posts.map((post) => (
              <article class="blog-card reveal">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                {post.data.tags && (
                  <ul class="blog-tags">
                    {post.data.tags.slice(0, 2).map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
                <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <a class="text-link" href={`/blog/${post.id}/`}>Leer guía</a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>

<style>
  .blog-hero {
    background: var(--navy);
    color: var(--cream);
    padding-top: calc(var(--header) + clamp(40px, 6vw, 72px));
    padding-bottom: clamp(48px, 7vw, 84px);
    border-bottom: 1px solid var(--line-light);
  }
  .blog-back {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--gold);
    font-size: .8rem;
    font-weight: 650;
    letter-spacing: .04em;
    margin-bottom: 2rem;
    border-bottom: 1px solid rgba(139,115,85,.3);
    padding-bottom: 1px;
    transition: color .2s, border-color .2s;
  }
  .blog-back:hover { color: var(--navy); border-color: var(--navy); }
  .blog-hero .bc { margin-bottom: 1.4rem; }
  .blog-hero .eyebrow { color: var(--gold-300); }
  .blog-hero h1 { color: var(--white); font-size: clamp(2.4rem, 5vw, 4rem); margin-top: .35em; max-width: 20ch; }
  .blog-hero p { max-width: 56ch; margin-top: 1rem; color: rgba(245,240,232,.78); font-size: clamp(1rem, 1.5vw, 1.18rem); line-height: 1.55; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .blog-card { padding: 32px; background: var(--white); border: 1px solid var(--line); border-top: 2px solid var(--gold); display: flex; flex-direction: column; gap: 14px; }
  .blog-card time { color: var(--muted); font-size: .78rem; font-weight: 600; letter-spacing: .04em; }
  .blog-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .blog-tags li { padding: 3px 9px; border: 1px solid var(--line); color: var(--gold); font-size: .67rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .blog-card h2 { font-size: clamp(1.2rem, 2vw, 1.55rem); line-height: 1.15; }
  .blog-card h2 a { color: var(--navy); }
  .blog-card h2 a:hover { color: var(--gold); }
  .blog-card p { color: var(--muted); font-size: .95rem; line-height: 1.55; flex: 1; }
  .blog-empty { color: var(--muted); font-size: 1.1rem; }
  @media (max-width: 900px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .blog-grid { grid-template-columns: 1fr; } }
</style>
