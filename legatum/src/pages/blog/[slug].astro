---
import { getCollection, render } from 'astro:content';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Footer from '../../components/Footer.astro';
import Navbar from '../../components/Navbar.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.image ? `${site.url}${post.data.image}` : `${site.url}/og-image.png`,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: post.data.pubDate.toISOString(),
  inLanguage: 'es-MX',
  author: {
    '@type': 'Organization',
    name: post.data.author,
    url: site.url,
  },
  publisher: {
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: { '@type': 'ImageObject', url: `${site.url}/og-image.png` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/blog/${post.id}/` },
};
---

<BaseLayout
  title={`${post.data.title} | LEGATUM INTERNACIONAL`}
  description={post.data.description}
  canonical={`${site.url}/blog/${post.id}/`}
  ogType="article"
  pubDate={post.data.pubDate.toISOString()}
  author={post.data.author}
>
  <Navbar />
  <main id="main-content">
    <article class="post-wrap">
      <header class="post-hero section-navy">
        <div class="shell">
          <Breadcrumb
            crumbs={[{ label: 'Guías', href: '/blog/' }, { label: post.data.title }]}
            variant="dark"
          />
          {post.data.tags && (
            <ul class="blog-tags">
              {post.data.tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
            </ul>
          )}
          <h1>{post.data.title}</h1>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span aria-hidden="true">·</span>
            <span>{post.data.author}</span>
          </p>
        </div>
      </header>

      <div class="post-body section section-paper">
        <div class="shell">
          <div class="post-content">
            <a class="post-back-link" href="/blog/">← Volver a guías</a>
            <Content />
          </div>
          <aside class="post-cta">
            <p>¿Tiene dudas sobre su caso?</p>
            <a class="btn btn-whatsapp" href={site.whatsapp} target="_blank" rel="noopener noreferrer">
              Hablar con un especialista
            </a>
          </aside>
        </div>
      </div>
    </article>
  </main>
  <Footer />
  <WhatsAppFloat />
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
</BaseLayout>

<style>
  .post-hero {
    padding-top: calc(var(--header) + clamp(40px, 6vw, 72px));
    padding-bottom: clamp(48px, 7vw, 80px);
    border-bottom: 1px solid var(--line-light);
  }
  .post-hero .bc { margin-bottom: 1.4rem; }
  .blog-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1.4rem; }
  .blog-tags li { padding: 3px 9px; border: 1px solid rgba(196,168,130,.4); color: var(--gold-300); font-size: .67rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .post-hero h1 { color: var(--white); font-size: clamp(2rem, 4.5vw, 3.6rem); margin-top: .5em; max-width: 22ch; }
  .post-meta { display: flex; gap: .75rem; align-items: center; margin-top: 1.2rem; color: rgba(245,240,232,.6); font-size: .84rem; }
  .post-body .shell { display: grid; grid-template-columns: 1fr 280px; gap: 64px; align-items: start; }
  .post-back-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    color: var(--gold);
    font-size: .82rem;
    font-weight: 650;
    letter-spacing: .04em;
    border-bottom: 1px solid rgba(139,115,85,.3);
    padding-bottom: 1px;
    margin-bottom: 2.4rem;
    transition: color .2s, border-color .2s;
  }
  .post-back-link:hover { color: var(--navy); border-color: var(--navy); }
  .post-content { max-width: 720px; }
  .post-content :global(h2) { font-size: clamp(1.4rem, 2.5vw, 2rem); margin-block: 2.2rem .75rem; color: var(--navy); }
  .post-content :global(h3) { font-size: clamp(1.1rem, 1.8vw, 1.4rem); margin-block: 1.6rem .6rem; color: var(--navy); }
  .post-content :global(p) { color: var(--muted); line-height: 1.75; margin-bottom: 1.2rem; }
  .post-content :global(ul), .post-content :global(ol) { padding-left: 1.4rem; margin-bottom: 1.2rem; }
  .post-content :global(li) { list-style: disc; color: var(--muted); line-height: 1.7; margin-bottom: .4rem; }
  .post-content :global(a) { color: var(--gold); border-bottom: 1px solid rgba(139,115,85,.3); }
  .post-content :global(strong) { color: var(--navy); }
  .post-content :global(hr) { border: none; border-top: 1px solid var(--line); margin-block: 2.4rem; }
  .post-cta { position: sticky; top: calc(var(--header) + 32px); padding: 28px; background: var(--white); border: 1px solid var(--line); border-top: 2px solid var(--gold); display: flex; flex-direction: column; gap: 16px; }
  .post-cta p { color: var(--navy); font-family: var(--serif); font-size: 1.28rem; line-height: 1.3; }
  @media (max-width: 900px) { .post-body .shell { grid-template-columns: 1fr; } .post-cta { position: static; } }
</style>
