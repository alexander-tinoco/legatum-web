---
import { getImage } from 'astro:assets';
import heroImage from '../assets/brand/hero-arquitectura.png';
import Footer from '../components/Footer.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Navbar from '../components/Navbar.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../sections/ContactSection.astro';
import CoverageSection from '../sections/CoverageSection.astro';
import CTASection from '../sections/CTASection.astro';
import FAQSection from '../sections/FAQSection.astro';
import FirmSection from '../sections/FirmSection.astro';
import ObjecionesSection from '../sections/ObjecionesSection.astro';
import Hero from '../sections/Hero.astro';
import MethodSection from '../sections/MethodSection.astro';
import PrinciplesTicker from '../sections/PrinciplesTicker.astro';
import ResourcesSection from '../sections/ResourcesSection.astro';
import ServicesSection from '../sections/ServicesSection.astro';
import TestimonialsSection from '../sections/TestimonialsSection.astro';
import TrustSection from '../sections/TrustSection.astro';
import { site } from '../data/site';

const optimizedHero = await getImage({
  src: heroImage,
  format: 'avif',
  widths: [480, 768, 1200, 1672],
  sizes: '100vw',
});
---

<BaseLayout
  title="Asesoría en visas, pasaportes y movilidad internacional | Legatum Internacional"
  description={site.description}
  canonical={`${site.url}/`}
>
  <Fragment slot="head">
    <link
      rel="preload"
      as="image"
      imagesrcset={optimizedHero.srcSet.attribute}
      imagesizes="100vw"
      fetchpriority="high"
      type="image/avif"
    />
  </Fragment>
  <Navbar />
  <main id="main-content">
    <Hero />
    <PrinciplesTicker />
    <ServicesSection />
    <MethodSection />
    <FirmSection />
    <CoverageSection />
    <TrustSection />
    <NewsletterForm />
    <TestimonialsSection />
    <ObjecionesSection />
    <FAQSection />
    <ResourcesSection />
    <ContactSection />
    <CTASection />
  </main>
  <Footer />
  <WhatsAppFloat />
</BaseLayout>
